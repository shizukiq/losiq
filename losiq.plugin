    "....KWWWWKWRWWK...",
    "...KKKKKK.KKKKKK..",
    "...KWWWWK.KWWWWK..",
    "...KKKKKK.KKKKKK..",
)

# Спит на висилице: верёвка с узлом, петля на шее, голова набок, язык свисает
