    def _reload_cfg(self):
        self._cfg = {
            "show": bool(self.get_setting("show", True)),
            "size": int(self.get_setting("size", 1) or 0),
            "color": int(self.get_setting("color", 0) or 0),
            "skin": int(self.get_setting("skin", 0) or 0),
            "avatar_path": str(self.get_setting("avatar_path", "") or "").strip(),
            "avatar_dir": str(self.get_setting("avatar_dir", "") or "").strip(),
            "gravity": bool(self.get_setting("gravity", False)),
            "wander": bool(self.get_setting("wander", True)),
            "phrases": bool(self.get_setting("phrases", True)),
            "sleep": int(self.get_setting("sleep", 1) or 0),
            "haptics": bool(self.get_setting("haptics", True)),
            "temper": int(self.get_setting("temper", 2) or 0),
            "chaos": bool(self.get_setting("chaos", True)),
            "chat_write": bool(self.get_setting("chat_write", True)),
            "sensitive_lines": bool(self.get_setting("sensitive_lines", False)),
            "test_anim": 0,
            "tg_events": bool(self.get_setting("tg_events", True)),
            "dance": bool(self.get_setting("dance", True)),
            "shake": bool(self.get_setting("shake", True)),
            "ai_enabled": bool(self.get_setting("ai_enabled", False)),
            "ai_key": str(self.get_setting("ai_key", "") or "").strip(),
            "ai_provider": int(self.get_setting("ai_provider", 0) or 0),
            "ai_url": str(self.get_setting("ai_url", "") or "").strip(),
            "ai_model": str(self.get_setting("ai_model", "") or "").strip(),
            "ai_chat": int(self.get_setting("ai_chat", 1) or 0),
            "ai_moods": bool(self.get_setting("ai_moods", True)),
            "ai_move": bool(self.get_setting("ai_move", True)),
            "ai2_url": str(self.get_setting("ai2_url", "") or "").strip(),
            "ai2_key": str(self.get_setting("ai2_key", "") or "").strip(),
            "ai2_model": str(self.get_setting("ai2_model", "") or "").strip(),
            "ai_text": bool(self.get_setting("ai_text", False)),
            "ai_persona": str(self.get_setting("ai_persona", "") or "").strip(),
            "ai_fallback": bool(self.get_setting("ai_fallback", True)),
            "brain_enabled": bool(self.get_setting("brain_enabled", True)),
            "brain_name": str(self.get_setting("brain_name", "") or "").strip(),
            "brain_about": str(self.get_setting("brain_about", "") or "").strip(),
            "brain_learn": bool(self.get_setting("brain_learn", True)),
            "brain_share": bool(self.get_setting("brain_share", True)),
        }

    def _migrate_avatar_pool(self):
        """Встроенные аватары стоят первыми: сдвигаем старый выбор, чтобы он не слетел."""
        try:
            version = int(self.get_setting("avatar_pool_version", 0) or 0)
        except Exception:
            version = 0
        if version >= AVATAR_POOL_VERSION:
            return
        skin = int(self._cfg.get("skin", 0) or 0)
        if skin >= 1:
            skin += len(BUILTIN_AVATARS)
            self._cfg["skin"] = skin
            try:
                self.set_setting("skin", skin)
            except Exception as e:
                log(f"[{__id__}] avatar migration error: {e}")
        try:
            self.set_setting("avatar_pool_version", AVATAR_POOL_VERSION)
        except Exception as e:
            log(f"[{__id__}] avatar version error: {e}")

    def _on_skin_change(self, index):
        # Выбор из списка главнее ручного пути: иначе встроенный аватар не применится.
        if index >= 1 and self._cfg.get("avatar_path"):
            self._cfg["avatar_path"] = ""
            try:
                self.set_setting("avatar_path", "")
            except Exception as e:
                log(f"[{__id__}] avatar path clear error: {e}")
        self._on_cfg_change("skin", index)

    def _on_cfg_change(self, key, value):
        self._cfg[key] = value
        if key == "show":
            run_on_ui_thread(lambda: self._apply_show(bool(value)))
        elif key in ("size", "color"):
            run_on_ui_thread(self._rebuild_sprites)
        elif key in ("skin", "avatar_path", "avatar_dir"):
            self._avatar_cache = None
            if key == "avatar_dir":
                self._invalidate_avatar_files()
            run_on_ui_thread(self._rebuild_sprites)
        elif key == "sleep" and self._state == "sleep":
            self._last_interaction = time.monotonic()
        elif key == "shake":
            run_on_ui_thread(self._start_sensor if value else self._stop_sensor)
        elif key == "gravity" and not value:
            self._platform = None
            self._slide_v = 0.0

    def _toast(self, text):
        """Короткое сообщение поверх любого экрана: в настройках пузырь Луз1ка не виден."""
        if BulletinHelper is not None:
            try:
                BulletinHelper.show_info(text)
                return
            except Exception:
                pass
        self._show_bubble(text)

    def _on_avatar_menu(self, context):
        """Пункт меню сообщения: сделать присланную картинку аватаром Луз1ка."""
        message = context.get("message") if isinstance(context, dict) else None
        if message is None:
            self._show_bubble("Тут нет картинки")
            return
        threading.Thread(target=self._avatar_from_message, args=(message,), daemon=True).start()

    def _avatar_from_message(self, message):
        try:
            owner = message.messageOwner
            path = str(getattr(owner, "attachPath", "") or "")
            if not path or not os.path.exists(path):
                from org.telegram.messenger import FileLoader
                file = FileLoader.getPathToMessage(owner)
                path = str(file.getAbsolutePath()) if file is not None else ""
            if not path or not os.path.exists(path):
                run_on_ui_thread(lambda: self._show_bubble("Картинка ещё не скачана — открой её и повтори"))
                return
            directory = self._avatar_dir()
            if not directory:
                run_on_ui_thread(lambda: self._show_bubble("Не нашёл папку для аватаров"))
                return
            ext = os.path.splitext(path)[1].lower()
            if ext not in AVATAR_EXT:
                ext = ".png"
            index = self._next_avatar_index()
            target = os.path.join(directory, f"{AVATAR_PREFIX}{index}{ext}")
            while os.path.exists(target):
                index += 1
                target = os.path.join(directory, f"{AVATAR_PREFIX}{index}{ext}")
            shutil.copyfile(path, target)
            run_on_ui_thread(lambda p=target: self._avatar_applied_path(p))
        except Exception as e:
            log(f"[{__id__}] avatar menu error: {e}")
            run_on_ui_thread(lambda: self._show_bubble("Не получилось поставить аватар"))

    # ---------- загрузка картинки из галереи ----------

    def _on_gallery_click(self, view=None):
        """Настройки → «Загрузить из галереи»: выбор картинки, потом обрезка."""
        try:
            context = view.getContext() if view is not None else None
            activity = self._activity_from_context(context)
            if activity is None:
                activity = self._current_activity()
            if activity is None:
                self._toast("Не нашёл окно приложения")
                return
            self._pick_context = context if context is not None else activity
            intent = None
            try:
                if int(Build.VERSION.SDK_INT) >= 33:
                    intent = Intent("android.provider.action.PICK_IMAGES")
                    intent.setType("image/*")
                    if activity.getPackageManager().resolveActivity(intent, 0) is None:
                        intent = None
            except Exception:
                intent = None
            if intent is None:
                intent = Intent(Intent.ACTION_GET_CONTENT)
                intent.setType("image/*")
                intent.addCategory(Intent.CATEGORY_OPENABLE)
            try:
                intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            except Exception:
                pass
            self._install_result_hooks(activity)
            self._gallery_pending = True
            activity.startActivityForResult(intent, GALLERY_REQUEST)
        except Exception as e:
            log(f"[{__id__}] gallery open error: {e}")
            self._gallery_pending = False
            self._toast("Не получилось открыть галерею")

    def _activity_from_context(self, context):
        if context is None:
            return None
        try:
            from android.app import Activity
        except Exception:
            return None
        node = context
        for _ in range(12):
            try:
                if isinstance(node, Activity):
                    return node
            except Exception:
                return None
            try:
                parent = node.getBaseContext()
            except Exception:
                return None
            if parent is None or parent is node:
                return None
            node = parent
        return None

    def _install_result_hooks(self, activity):
        """Ловит onActivityResult у экрана настроек (и родичей), чтобы забрать выбор из галереи."""
        try:
            cls = activity.getClass()
        except Exception:
            cls = None
        hook = ActivityResultHook(self)
        depth = 0
        while cls is not None and depth < 12:
            depth += 1
            try:
                name = str(cls.getName())
            except Exception:
                break
            if name.startswith("android.") or name.startswith("java."):
                break
            if name not in self._result_hooked_classes:
                self._result_hooked_classes.add(name)
                try:
                    hooks = self.hook_all_methods(cls, "onActivityResult", hook)
                except Exception as e:
                    hooks = None
                    log(f"[{__id__}] result hook error ({name}): {e}")
                if hooks:
                    self._result_hooks.extend(hooks)
            try:
                cls = cls.getSuperclass()
            except Exception:
                break
        if not self._result_hooks and find_class is not None:
            # последний шанс: сам метод Activity, если движок умеет хукать framework
            try:
                framework = find_class("android.app.Activity")
                hooks = self.hook_all_methods(framework, "onActivityResult", hook)
                if hooks:
                    self._result_hooks.extend(hooks)
            except Exception as e:
                log(f"[{__id__}] result hook fallback error: {e}")

    def _on_activity_result(self, request, result, data):
        if request != GALLERY_REQUEST or self._unloaded or not self._gallery_pending:
            return
        self._gallery_pending = False
        if result != -1 or data is None:
            return
        try:
            uri = data.getData()
        except Exception as e:
            log(f"[{__id__}] gallery data error: {e}")
            uri = None
        if uri is None:
            self._toast("Не получилось прочитать выбор")
            return
        threading.Thread(target=self._pick_image, args=(uri,), daemon=True).start()

    def _pick_image(self, uri):
        try:
            bmp = self._decode_picked(uri)
        except Exception as e:
            log(f"[{__id__}] pick decode error: {e}")
            bmp = None
        if bmp is None:
            run_on_ui_thread(lambda: self._toast("Не получилось открыть картинку"))
            return
        run_on_ui_thread(lambda b=bmp: self._open_crop(b))

    def _decode_picked(self, uri):
        try:
            context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        except Exception:
            context = None
        if context is None:
            return None
        resolver = context.getContentResolver()
        opts = BitmapFactory.Options()
        opts.inJustDecodeBounds = True
        stream = resolver.openInputStream(uri)
        if stream is None:
            return None
        try:
            BitmapFactory.decodeStream(stream, None, opts)
        finally:
            stream.close()
        width, height = int(opts.outWidth), int(opts.outHeight)
        if width <= 0 or height <= 0:
            return None
        sample = 1
        while max(width, height) // sample > CROP_SOURCE_MAX:
            sample *= 2
        opts2 = BitmapFactory.Options()
        opts2.inSampleSize = sample
        stream = resolver.openInputStream(uri)
        if stream is None:
            return None
        try:
            bmp = BitmapFactory.decodeStream(stream, None, opts2)
        finally:
            stream.close()
        if bmp is None:
            return None
        return self._apply_exif_orientation(bmp, resolver, uri)

    def _apply_exif_orientation(self, bmp, resolver, uri):
        orientation = 0
        try:
            stream = resolver.openInputStream(uri)
            if stream is None:
                return bmp
            try:
                try:
                    from androidx.exifinterface.media import ExifInterface
                except Exception:
                    from android.media import ExifInterface
                exif = ExifInterface(stream)
                orientation = int(exif.getAttributeInt(ExifInterface.TAG_ORIENTATION, 1))
            finally:
                stream.close()
        except Exception:
            return bmp
        if orientation not in (3, 6, 8):
            return bmp
        try:
            matrix = Matrix()
            matrix.postRotate(90 if orientation == 6 else (180 if orientation == 3 else 270))
            rotated = Bitmap.createBitmap(bmp, 0, 0, bmp.getWidth(), bmp.getHeight(), matrix, True)
            if rotated is not None and rotated is not bmp:
                return rotated
        except Exception as e:
            log(f"[{__id__}] exif rotate error: {e}")
        return bmp

    def _open_crop(self, bmp):
        if self._unloaded:
            return
        try:
            self._close_cropper()
            context = self._pick_context
            if context is None:
                context = self._current_activity()
            if context is None:
                return
            cropper = AvatarCropper(self, context, bmp)
            self._cropper = cropper
            cropper.show()
        except Exception as e:
            log(f"[{__id__}] crop open error: {e}")
            self._toast("Не получилось открыть обрезку")

    def _close_cropper(self):
        cropper = self._cropper
        self._cropper = None
        if cropper is not None:
            cropper.close()

    def _save_avatar_bitmap(self, bmp):
        """Сохраняет обрезанную картинку как новый luz1k_avatarN.png."""
        directory = self._avatar_dir()
        if not directory:
            return None
        try:
            if not os.path.isdir(directory):
                os.makedirs(directory)
        except Exception:
            pass
        index = self._next_avatar_index()
        target = os.path.join(directory, f"{AVATAR_PREFIX}{index}.png")
        while os.path.exists(target):
            index += 1
            target = os.path.join(directory, f"{AVATAR_PREFIX}{index}.png")
        try:
            stream = FileOutputStream(target)
            try:
                bmp.compress(Bitmap.CompressFormat.PNG, 100, stream)
            finally:
                stream.close()
        except Exception as e:
            log(f"[{__id__}] avatar save error: {e}")
            return None
        return target

    def _avatar_applied_path(self, path):
        self._avatar_cache = None
        self._invalidate_avatar_files()
        if self._cfg.get("avatar_path"):
            self._cfg["avatar_path"] = ""
            try:
                self.set_setting("avatar_path", "")
            except Exception as e:
                log(f"[{__id__}] avatar path clear error: {e}")
        try:
            files = self._avatar_files()
            index = files.index(path) + 1 if path in files else len(files)
        except Exception:
            index = 1
        try:
            self.set_setting("skin", index, reload_settings=True)
        except Exception:
            self.set_setting("skin", index)
        self._cfg["skin"] = index
        self._rebuild_sprites()
        self._toast("Моделька готова — потыкай её")

    def _on_menu_toggle(self, context=None):
        show = not self._cfg.get("show", True)
        self._cfg["show"] = show
        self.set_setting("show", show)
        run_on_ui_thread(lambda: self._apply_show(show))

    def _apply_show(self, show):
        if show:
            self._start(greet=True)
        else:
            self._running = False
            if self._handler is not None:
                self._handler.removeCallbacks(self._tick_r)
            self._stop_sensor()
            self._detach_views(True)

    def _on_ui(self, fn):
        try:
            if Looper.myLooper() == Looper.getMainLooper():
                fn()
                return
        except Exception:
            pass
        run_on_ui_thread(fn)

    def _start(self, greet):
        if self._unloaded or self._paused or not self._cfg.get("show", True):
            return
        if greet:
            self._greet_pending = True
        try:
            self._ensure_attached()
        except Exception as e:
            log(f"[{__id__}] attach error: {e}")
        if self._pet is None:
            run_on_ui_thread(lambda: self._start(greet), 700)
            return
        self._running = True
        self._last_tick = time.monotonic()
        self._start_sensor()
        self._schedule(16)

    def _start_sensor(self):
        if (
            self._sensor_listener is not None
            or not self._running
            or self._paused
            or self._unloaded
            or not self._cfg.get("shake", True)
            or self._pet is None
        ):
            return
        try:
            manager = self._pet.getContext().getSystemService(Context.SENSOR_SERVICE)
            sensor = manager.getDefaultSensor(Sensor.TYPE_ACCELEROMETER) if manager is not None else None
            if sensor is None:
                return
            listener = ShakeListener(self)
            if manager.registerListener(listener, sensor, SensorManager.SENSOR_DELAY_UI):
                self._sensor_manager = manager
                self._sensor_listener = listener
                self._accel_prev = None
                self._shake_hits = []
        except Exception as e:
            log(f"[{__id__}] sensor start error: {e}")

    def _stop_sensor(self):
        manager = self._sensor_manager
        listener = self._sensor_listener
        self._sensor_manager = None
        self._sensor_listener = None
        self._tilt = 0.0
        if manager is None or listener is None:
            return
        try:
            manager.unregisterListener(listener)
        except Exception as e:
            log(f"[{__id__}] sensor stop error: {e}")

    def _current_activity(self):
        activity = None
        try:
            activity = LaunchActivity.instance
        except Exception:
            activity = None
        if activity is None:
            try:
                fragment = get_last_fragment()
                activity = fragment.getParentActivity() if fragment is not None else None
            except Exception:
                activity = None
        return activity

    def _ensure_attached(self):
        activity = self._current_activity()
        if activity is None or activity.isFinishing():
            return
        decor = activity.getWindow().getDecorView()
        if (
            self._pet is not None
            and self._decor is not None
            and self._pet.getParent() is not None
            and self._decor.equals(decor)
        ):
            return
        self._detach_views()
        self._decor = decor
        self._build_views(activity)

    def _build_views(self, context):
        self._update_metrics()
        pet = ImageView(context)
        pet.setScaleType(ImageView.ScaleType.FIT_XY)
        pet.setClickable(True)
        self._touch_listener = PetTouchListener(self)
        pet.setOnTouchListener(self._touch_listener)
        self._decor.addView(pet, FrameLayout.LayoutParams(self._w, self._h))
        self._pet = pet

        bubble = TextView(context)
        bubble.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13.0)
        bubble.setMaxWidth(AndroidUtilities.dp(220))
        bubble.setPadding(AndroidUtilities.dp(10), AndroidUtilities.dp(6), AndroidUtilities.dp(10), AndroidUtilities.dp(6))
        try:
            bubble.setTypeface(AndroidUtilities.bold())
        except Exception:
            pass
        bubble.setVisibility(View.GONE)
        self._decor.addView(bubble, FrameLayout.LayoutParams(-2, -2))
        self._bubble = bubble
        self._bubble_visible = False

        self._frame_key = None
        self._pos_ready = False

    def _detach_views(self, hard=False):
        if hard:
            self._ui_give_back()
        for view in list(self._particles):
            self._remove_view(view)
        self._particles = []
        self._remove_view(self._vomit_stain)
        self._vomit_stain = None
        self._stain_click_listener = None
        self._close_chat()
        self._close_cropper()
        self._remove_view(self._bubble)
        self._remove_view(self._pet)
        self._pet = None
        self._bubble = None
        self._decor = None
        self._touch_listener = None
        self._touch = None
        self._shot = None
        self._platform = None
        self._platforms = []
        if self._state in ("press", "drag", "pet", "hang", "peek", "shot"):
            self._state = "idle"

    def _remove_view(self, view):
        if view is None:
            return
        try:
            view.animate().cancel()
        except Exception:
            pass
        try:
            parent = view.getParent()
            if parent is not None:
                parent.removeView(view)
        except Exception:
            pass

    def _update_metrics(self):
        size = clamp(int(self._cfg.get("size", 1)), 0, len(SIZE_DP) - 1)
        self._unit = max(2, AndroidUtilities.dp(SIZE_DP[size]))
        self._w = GRID_W * self._unit
        self._h = GRID_H * self._unit

    def _rebuild_sprites(self):
        old_w, old_h = self._w, self._h
        self._frames = {}
        self._particle_bitmaps = {}
        self._frame_key = None
        self._update_metrics()
        if self._pet is None:
            return
        self._x += (old_w - self._w) / 2.0
        self._y += old_h - self._h
        lp = self._pet.getLayoutParams()
        lp.width = self._w
        lp.height = self._h
        self._pet.setLayoutParams(lp)
        self._hop(AndroidUtilities.dp(300))
        self._schedule(16)

    def _palette(self):
        idx = clamp(int(self._cfg.get("color", 0)), 0, len(PALETTES) - 1)
        return PALETTES[idx]

    def _skin_index(self):
        return max(0, int(self._cfg.get("skin", 0) or 0))

    def _avatar_mode(self):
        return self._skin_index() >= 1 and self._avatar_file() is not None

    def _avatar_dir(self):
        override = self._cfg.get("avatar_dir") or ""
        if override and os.path.isdir(override):
            return override
        try:
            context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            return str(context.getFilesDir().getAbsolutePath())
        except Exception:
            return ""

    def _invalidate_avatar_files(self):
        self._avatar_files_cache = None

    def _ensure_builtin_avatars(self):
        """Раскладывает встроенные картинки в подпапку, чтобы их можно было выбрать."""
        directory = self._avatar_dir()
        if not directory:
            return []
        target_dir = os.path.join(directory, BUILTIN_AVATAR_DIR)
        paths = []
        with AVATAR_LOCK:
            for _label, name, data in BUILTIN_AVATARS:
                path = os.path.join(target_dir, name)
                try:
                    raw = base64.b64decode(data)
                    if not os.path.exists(path) or os.path.getsize(path) != len(raw):
                        if not os.path.isdir(target_dir):
                            os.makedirs(target_dir, exist_ok=True)
                        tmp = path + ".tmp"
                        with open(tmp, "wb") as f:
                            f.write(raw)
                        os.replace(tmp, path)
                except Exception as e:
                    log(f"[{__id__}] builtin avatar error: {e}")
                    continue
                paths.append(path)
        return paths

    def _avatar_label(self, path):
        name = os.path.basename(path)
        for label, builtin_name, _data in BUILTIN_AVATARS:
            if name == builtin_name:
                return label
        return name

    def _avatar_key(self):
        path = self._avatar_file()
        return os.path.basename(path) if path else ""

    def _avatar_prop_cells(self, afk):
        prop_set = AVATAR_PROP_SETS.get(self._avatar_key(), AVATAR_PROPS)
        return prop_set.get(afk)

    def _avatar_phrase_book(self):
        return AVATAR_PHRASES.get(self._avatar_key(), PHRASES)

    def _avatar_chat_book(self):
        return AVATAR_CHAT_LINES.get(self._avatar_key())

    def _pet_name(self):
        key = self._avatar_key()
        for label, name, _data in BUILTIN_AVATARS:
            if name == key:
                return label
        return "Луз1к"

    def _chat_pick(self, kind, default):
        book = self._avatar_chat_book()
        if book:
            return random.choice(book.get(kind, default))
        return random.choice(default)

    def _ai_system(self, key, base):
        overrides = AVATAR_SYSTEM_PROMPTS.get(self._avatar_key())
        return overrides.get(key, base) if overrides else base

    def _avatar_files(self):
        """Встроенные аватары, затем все luz1k_avatar*.png/jpg из папки плагина."""
        if getattr(self, "_avatar_files_cache", None) is not None:
            return self._avatar_files_cache
        files = list(self._ensure_builtin_avatars())
        directory = self._avatar_dir()
        if directory:
            try:
                names = [
                    n for n in os.listdir(directory)
                    if n.lower().startswith(AVATAR_PREFIX) and n.lower().endswith(AVATAR_EXT)
                ]
            except Exception:
                names = []

            def sort_key(name):
                match = re.search(re.escape(AVATAR_PREFIX) + r"(\d+)", name, re.IGNORECASE)
                return (int(match.group(1)) if match else 10 ** 6, name.lower())

            seen = {os.path.basename(p) for p in files}
            for name in sorted(names, key=sort_key):
                if name not in seen:
                    files.append(os.path.join(directory, name))
                    seen.add(name)
        self._avatar_files_cache = files
        return files

    def _next_avatar_index(self):
        """Следующий свободный номер для пользовательского файла, без учёта встроенных."""
        builtin_names = {name for _label, name, _data in BUILTIN_AVATARS}
        max_index = 0
        for path in self._avatar_files():
            name = os.path.basename(path)
            if name in builtin_names:
                continue
            match = re.search(re.escape(AVATAR_PREFIX) + r"(\d+)", name, re.IGNORECASE)
            if match:
                max_index = max(max_index, int(match.group(1)))
        return max_index + 1

    def _avatar_file(self):
        """Путь к выбранной картинке: явный путь или файл по индексу в списке."""
        explicit = self._cfg.get("avatar_path") or ""
        if explicit and os.path.exists(explicit):
            return explicit
        files = self._avatar_files()
        idx = self._skin_index() - 1
        if 0 <= idx < len(files):
            return files[idx]
        return files[0] if files else None

    def _avatar_bitmap(self):
        if self._avatar_cache is not None:
            return self._avatar_cache
        path = self._avatar_file()
        bmp = None
        try:
            if path and os.path.exists(path):
                bmp = BitmapFactory.decodeFile(path)
        except Exception as e:
            log(f"[{__id__}] avatar load error: {e}")
            bmp = None
        if bmp is not None:
            self._avatar_cache = bmp
        return bmp

    def _draw_cells(self, canvas, paint, pal, cells):
        """Рисует список клеток (x, y, символ) пиксельными квадратами."""
        s = self._unit
        for x, y, ch in cells:
            paint.setColor(jint(as_java_color(pal.get(ch, 0xFF000000))))
            canvas.drawRect(float(x * s), float(y * s), float((x + 1) * s), float((y + 1) * s), paint)

    def _get_frame(self, key):
        cache_key = key
        if self._avatar_mode() and self._avatar_bitmap() is not None:
            body = ("avatar", self._skin_index(), self._w, self._h)
            if key[3] == "tuck" and key[0] == "sleep":
                cache_key = body + ("rope",)
            elif key[7] is not None:
                cache_key = body + ("afk", key[7])
            else:
                cache_key = body
        bmp = self._frames.get(cache_key)
        if bmp is None:
            if len(self._frames) >= MAX_FRAME_CACHE:
                self._frames.pop(next(iter(self._frames)))
            bmp = self._render_frame(key)
            self._frames[cache_key] = bmp
        return bmp

    def _render_frame(self, key):
        eyes, look, arms, legs, squash, blush, mouth, afk = key
        pal = self._palette()[1]
        s = self._unit
        bmp = Bitmap.createBitmap(self._w, self._h, Bitmap.Config.ARGB_8888)
        canvas = Canvas(bmp)
        paint = Paint()

        hang_frame = legs == "tuck" and eyes == "sleep"
        avatar = self._avatar_bitmap() if self._avatar_mode() else None
        if avatar is not None:
            if hang_frame:
                self._draw_cells(canvas, paint, pal, ROPE_CELLS)
            if afk == "shot_gone":
                self._draw_cells(canvas, paint, pal, self._avatar_prop_cells("shot_gone"))
                return bmp
            aw, ah = avatar.getWidth(), avatar.getHeight()
            if aw > 0 and ah > 0:
                scale = min(self._w / float(aw), self._h / float(ah))
                dw, dh = aw * scale, ah * scale
                left = (self._w - dw) / 2.0
                top = self._h - dh
                paint.setFilterBitmap(True)
                canvas.drawBitmap(
                    avatar,
                    Rect(0, 0, aw, ah),
                    Rect(int(left), int(top), int(left + dw), int(top + dh)),
                    paint,
                )
                paint.setFilterBitmap(False)
                if afk in ("shot_re1", "shot_re2"):
                    paint.setColor(jint(as_java_color(0x99D92B2B if afk == "shot_re1" else 0x99BFBFBF)))
                    canvas.drawRect(float(left), float(top), float(left + dw), float(top + dh), paint)
                props = self._avatar_prop_cells(afk)
                if props:
                    self._draw_cells(canvas, paint, pal, props)
                return bmp

        def cell(x, y, color):
            paint.setColor(jint(as_java_color(color)))
            canvas.drawRect(float(x * s), float(y * s), float((x + 1) * s), float((y + 1) * s), paint)

        base = FRAME_MATRIX.get(afk) if afk else None
        if base is None:
            base = SPRITE_HANG if (legs == "tuck" and eyes == "sleep") else SPRITE_IDLE
        for y, row in enumerate(base):
            for x, ch in enumerate(row):
                if ch == ".":
                    continue
                cell(x, y, pal.get(ch, 0xFF000000))

        if base is SPRITE_IDLE and eyes != "sleep":
            eye_col = 0xFFFF1E1E if eyes == "angry" else pal["E"]
            blush_col = mix_color(pal["W"], 0xFFFF4F79, 0.55)
            for ex, side in ((EYE_L, -1), (EYE_R, 1)):
                for x in range(ex - 1, ex + 2):
                    for y in (EYE_TOP, EYE_BOT):
                        cell(x, y, pal["W"])
                px = ex + (look if eyes in ("open", "surprised") else 0)
                if eyes == "open":
                    cell(px, EYE_TOP, eye_col)
                    cell(px, EYE_BOT, eye_col)
                elif eyes == "blink":
                    pass
                elif eyes == "happy":
                    cell(ex - 1, EYE_BOT, eye_col)
                    cell(ex, EYE_TOP, eye_col)
                    cell(ex + 1, EYE_BOT, eye_col)
                elif eyes == "surprised":
                    cell(px, EYE_TOP - 1, eye_col)
                    cell(px, EYE_TOP, eye_col)
                    cell(px, EYE_BOT, eye_col)
                elif eyes == "dizzy":
                    cell(ex - 1, EYE_TOP - 1, eye_col)
                    cell(ex + 1, EYE_TOP - 1, eye_col)
                    cell(ex, EYE_TOP, eye_col)
                    cell(ex - 1, EYE_BOT, eye_col)
                    cell(ex + 1, EYE_BOT, eye_col)
                elif eyes == "angry":
                    cell(px, EYE_TOP, eye_col)
                    cell(px, EYE_BOT, eye_col)
                    cell(ex + side, EYE_TOP - 1, eye_col)
                elif eyes == "sad":
                    cell(px, EYE_TOP, eye_col)
                    cell(px, EYE_BOT, eye_col)
                    cell(ex - side, EYE_TOP - 1, eye_col)
                elif eyes == "sleep":
                    for x in range(ex - 1, ex + 2):
                        cell(x, EYE_BOT, eye_col)
            if blush:
                cell(EYE_L - 2, 8, blush_col)
                cell(EYE_L - 1, 8, blush_col)
                cell(EYE_R + 1, 8, blush_col)
                cell(EYE_R + 2, 8, blush_col)
            if mouth == "open":
                for x in (8, 9, 10):
                    cell(x, 10, pal["E"])
                    cell(x, 11, pal["E"])
        return bmp

    def _particle_bitmap(self, kind):
        bmp = self._particle_bitmaps.get(kind)
        if bmp is not None:
            return bmp
        rows = PATTERNS[kind]
        colors = {"X": {
            "heart": HEART_COLOR, "zzz": ZZZ_COLOR, "spark": SPARK_COLOR,
            "note": NOTE_COLOR, "vapor": VAPOR_COLOR, "blood": BLOOD_COLOR,
            "beer": BEER_COLOR,
        }[kind]}
        s = max(2, int(self._unit * 0.75))
        bmp = Bitmap.createBitmap(len(rows[0]) * s, len(rows) * s, Bitmap.Config.ARGB_8888)
        canvas = Canvas(bmp)
        paints = {}
        for ch, color in colors.items():
            paint = Paint()
            paint.setColor(jint(as_java_color(color)))
            paints[ch] = paint
        for y, row in enumerate(rows):
            for x, ch in enumerate(row):
                paint = paints.get(ch)
                if paint is not None:
                    canvas.drawRect(float(x * s), float(y * s), float((x + 1) * s), float((y + 1) * s), paint)
        self._particle_bitmaps[kind] = bmp
        return bmp

    def _reset_state(self):
        now = time.monotonic()
        self._state = "idle"
        self._x = 0.0
        self._y = 0.0
        self._vx = 0.0
        self._vy = 0.0
        self._pos_ready = False
        self._last_tick = now
        self._last_interaction = now
        self._next_action = now + 4.0
        self._next_chaos = now + 10.0
        self._next_blink = now + 2.0
        self._blink_until = 0.0
        self._look = 0
        self._expr = None
        self._expr_until = 0.0
        self._squash_until = 0.0
        self._wave_until = 0.0
        self._hop_active = False
        self._hop_off = 0.0
        self._hop_vy = 0.0
        self._walk_target = 0.0
        self._touch = None
        self._last_tap = 0.0
        self._recent_taps = []
        self._next_heart = 0.0
        self._next_z = 0.0
        self._bubble_visible = False
        self._bubble_fade_in = False
        self._bubble_until = 0.0
        self._bubble_gen = 0
        self._last_phrase = None
        self._bounds_cache = None
        self._bounds_time = 0.0
        self._attach_check = 0.0
        self._greet_pending = False
        self._afk_kind = None
        self._afk_idx = 0
        self._afk_next = 0.0
        self._afk_frame = None
        self._input_cache = None
        self._input_time = 0.0
        self._media = None
        self._media_track = None
        self._media_check = 0.0
        self._next_note = 0.0
        self._next_msg_react = 0.0
        self._next_sent_react = 0.0
        self._chat_dialog = 0
        self._next_chat_comment = now + 8.0
        self._next_chat_send = now + 20.0
        self._rotation = 0
        self._accel_prev = None
        self._shake_hits = []
        self._shake_pending = 0.0
        self._shake_dizzy = False
        self._shake_vomit = False
        self._sick_pending = 0.0
        self._forced_afk = False
        self._pet_taps = []
        self._next_afk_fx = 0.0
        self._tilt = 0.0
        self._slide_v = 0.0
        self._next_slide_say = 0.0
        self._platform = None
        self._platforms = []
        self._platform_scan = 0.0
        self._platform_moving = False
        self._walk_in = False
        self._hang_start = 0.0
        self._hang_until = 0.0
        self._peek_side = 0
        self._peek_pending = 0
        self._peek_phase = "hide"
        self._peek_phase_until = 0.0
        self._peek_end = 0.0
        self._peek_moving = False
        self._platform_span = None
        self._next_peek = now + PEEK_AFTER

    def _schedule(self, delay):
        if self._handler is None or self._tick_r is None:
            return
        self._handler.removeCallbacks(self._tick_r)
        self._handler.postDelayed(self._tick_r, int(delay))

    def _tick(self):
        if not self._running or self._paused:
            return
        try:
            self._step()
        except Exception as e:
            log(f"[{__id__}] tick error: {e}")
        if self._running and not self._paused:
            self._schedule(self._next_delay())

    def _next_delay(self):
        if self._pet is None:
            return 1000
        now = time.monotonic()
        if (
            self._state in ("press", "drag", "pet", "fly", "walk")
            or self._hop_active
            or self._bubble_fade_in
            or self._walk_in
            or self._platform_moving
            or self._slide_v
            or self._shake_pending
            or self._shot is not None
            or now < self._squash_until
            or (self._expr == "dizzy" and now < self._expr_until)
        ):
            return 16
        if self._state in ("hang", "peek"):
            return 33
        if self._state == "sleep":
            return 33
        if self._afk_kind is not None or self._afk_frame is not None:
            return 33
        if self._media and self._state == "idle":
            return 33
        return 80

    def _dp(self, value):
        return float(AndroidUtilities.dp(value))

    def _bounds(self, now):
        if self._bounds_cache is not None and now - self._bounds_time < 0.4:
            return self._bounds_cache
        decor = self._decor
        width = decor.getWidth()
        height = decor.getHeight()
        top_inset = AndroidUtilities.statusBarHeight
        bottom_inset = AndroidUtilities.navigationBarHeight
        visible_bottom = float(height - bottom_inset)
        try:
            insets = decor.getRootWindowInsets()
            if insets is not None:
                top_inset = insets.getSystemWindowInsetTop()
                bottom_inset = insets.getSystemWindowInsetBottom()
                visible_bottom = float(height - bottom_inset)
        except Exception:
            pass
        try:
            frame = Rect()
            decor.getWindowVisibleDisplayFrame(frame)
            if frame.bottom > 0:
                visible_bottom = min(visible_bottom, float(frame.bottom))
        except Exception:
            pass
        try:
            display = decor.getDisplay()
            if display is not None:
                self._rotation = int(display.getRotation())
        except Exception:
            pass
        self._bounds_cache = (
            0.0,
            float(max(0, width - self._w)),
            float(top_inset),
            float(max(top_inset, min(visible_bottom, height - bottom_inset) - self._h)),
            width,
            height,
        )
        self._bounds_time = now
        return self._bounds_cache

    def _step(self):
        now = time.monotonic()
        dt = clamp(now - self._last_tick, 0.0, 0.05)
        self._last_tick = now

        if now >= self._attach_check:
            self._attach_check = now + 1.0
            self._ensure_attached()
            if self._pet is not None and self._pos_ready:
                self._poll_chat(now)
        if self._pet is None or self._decor is None:
            return
        if self._pos_ready:
            self._poll_media(now)
        if self._decor.getWidth() <= 0:
            return

        min_x, max_x, min_y, max_y, width, height = self._bounds(now)
        if not self._pos_ready:
            self._restore_position(min_x, max_x, min_y, max_y)
            self._pos_ready = True
            if self._greet_pending:
                self._greet_pending = False
                self._hop(self._dp(420))
                self._say("hello")

        if self._shot is not None:
            self._step_shot(now)
            self._render(now)
            self._update_bubble(now, width, min_y)
            return

        gravity = bool(self._cfg.get("gravity", False))
        state = self._state

        if state == "press" and self._touch is not None and now - self._touch["t0"] >= 0.4:
            self._start_pet(now)
            state = self._state

        if self._shake_pending and state not in ("press", "drag", "pet"):
            self._apply_shake(now, gravity)
            state = self._state

        if state == "pet":
            if now >= self._next_heart:
                self._next_heart = now + 0.45
                self._spawn_particle("heart")
                self._haptic(4)
        elif state == "fly":
            self._step_fly(dt, now, gravity, min_x, max_x, min_y, max_y)
        elif state == "hang":
            self._step_hang(now, gravity, min_x, max_x, min_y)
        elif state == "peek":
            self._step_peek(dt, now, width)
        elif state in ("idle", "walk", "sleep"):
            self._step_ground(dt, now, gravity, min_x, max_x, min_y, max_y)

        if self._hop_active:
            self._hop_off += self._hop_vy * dt
            self._hop_vy += self._dp(2600) * dt
            if self._hop_off >= 0.0:
                self._hop_off = 0.0
                self._hop_vy = 0.0
                self._hop_active = False
                self._squash_until = now + 0.1

        self._render(now)
        self._update_bubble(now, width, min_y)

    def _step_ground(self, dt, now, gravity, min_x, max_x, min_y, max_y):
        self._walk_in = False
        if self._state != "walk":
            if self._x < min_x - 0.5 or self._x > max_x + 0.5:
                step = self._dp(60) * dt
                if self._x < min_x:
                    self._x = min(min_x, self._x + step)
                    self._look = 1
                else:
                    self._x = max(max_x, self._x - step)
                    self._look = -1
                self._walk_in = True
            else:
                self._x = clamp(self._x, min_x, max_x)

        self._platform_moving = False
        if gravity:
            if self._platform is not None:
                if not self._follow_platform(min_y, max_y):
                    self._fall(self._dp(42) * self._look if self._state == "walk" else 0.0)
                    return
            elif self._y < max_y - 0.5 and not self._hop_active:
                self._fall(0.0)
                return
            else:
                self._y = min(self._y, max_y)
            if self._step_slide(dt, now, min_x, max_x):
                return
        else:
            self._y = clamp(self._y, min_y, max_y)
            self._slide_v = 0.0

        if self._state == "walk":
            chaos_gap = self._chaos_level()
            if chaos_gap > 0 and now >= self._next_chaos:
                self._next_chaos = now + chaos_gap * random.uniform(0.7, 1.3)
                self._do_chaos(now, min_y)
                return
            direction = 1 if self._walk_target > self._x else -1
            self._look = direction
            self._x += direction * self._dp(42) * dt
            reached = (direction > 0 and self._x >= self._walk_target) or (direction < 0 and self._x <= self._walk_target)
            hit_edge = (direction < 0 and self._x <= min_x) or (direction > 0 and self._x >= max_x)
            if reached or hit_edge:
                self._x = clamp(self._x, min_x, max_x)
                self._state = "idle"
                self._next_action = now + random.uniform(2.5, 6.0)
                side = self._peek_pending
                self._peek_pending = 0
                edge = self._dp(4)
                if side and ((side < 0 and self._x <= min_x + edge) or (side > 0 and self._x >= max_x - edge)):
                    self._start_peek(now, side)
                    return
                self._save_position()
            return

        if self._state == "sleep":
            if now >= self._next_z:
                self._next_z = now + 1.6
                self._spawn_particle("zzz")
            chaos_gap = self._chaos_level()
            if chaos_gap > 0 and now >= self._next_chaos:
                self._next_chaos = now + chaos_gap * random.uniform(0.7, 1.3)
                self._state = "idle"
                self._do_chaos(now, min_y)
            return

        if now >= self._next_blink:
            self._blink_until = now + 0.13
            self._next_blink = now + (0.35 if random.random() < 0.15 else random.uniform(2.0, 5.5))

        chaos_gap = self._chaos_level()
        if chaos_gap > 0 and now >= self._next_chaos:
            self._next_chaos = now + chaos_gap * random.uniform(0.7, 1.3)
            self._do_chaos(now, min_y)
            return

        sleep_idx = clamp(int(self._cfg.get("sleep", 1)), 0, len(SLEEP_SECONDS) - 1)
        timeout = SLEEP_SECONDS[sleep_idx]
        if (
            timeout
            and self._temper_idx() < 4
            and now - self._last_interaction > timeout
            and not self._hop_active
            and not self._media
            and not self._walk_in
        ):
            self._state = "sleep"
            self._look = 0
            self._next_z = now + 0.6
            self._hide_bubble()
            return

        if self._media:
            if now >= self._next_note:
                self._next_note = now + (0.8 if self._media == "music" else 1.5)
                self._spawn_particle("note")
            return

        if self._sick_pending and now >= self._sick_pending and not self._hop_active and not self._walk_in:
            self._sick_pending = 0.0
            self._start_sick(now)

        idle_for = now - self._last_interaction
        if (idle_for >= AFK_AFTER or self._forced_afk) and not self._hop_active and not self._walk_in:
            self._step_afk(now)
            return
        self._afk_kind = None
        self._afk_frame = None

        if now < self._next_action or self._hop_active or self._walk_in:
            return
        self._next_action = now + random.uniform(3.5, 9.0)
        roll = random.random()
        if not self._cfg.get("wander", True):
            if roll < 0.5:
                self._look = random.choice((-1, 0, 1))
            return
        if (
            self._platform is None
            and now >= self._next_peek
            and now - self._last_interaction > PEEK_AFTER
            and roll < 0.3
        ):
            side = -1 if self._x - min_x < max_x - self._x else 1
            self._walk_target = min_x if side < 0 else max_x
            self._peek_pending = side
            self._state = "walk"
            return
        if roll < 0.38:
            distance = random.uniform(self._dp(40), self._dp(160)) * random.choice((-1, 1))
            lo, hi = min_x, max_x
            if self._platform is not None and self._platform_span is not None:
                x0, x1 = self._platform_span
                lo = max(lo, x0 - self._unit * 4)
                hi = min(hi, x1 - self._unit * 14)
            target = clamp(self._x + distance, lo, hi)
            if abs(target - self._x) > self._dp(12):
                self._walk_target = target
                self._state = "walk"
        elif roll < 0.58:
            self._look = random.choice((-1, 0, 1))
        elif roll < 0.72:
            self._say("idle")
        elif roll < 0.84:
            self._hop(self._dp(360))
        else:
            self._wave_until = now + 1.6

    def _do_chaos(self, now, min_y):
        """Выбирает одно действие. Открывать чаты и писать в них может только ПСИХ."""
        psi = self._temper_idx() >= 4
        actions = [("eat", 0.36), ("hurl", 0.18), ("rotate", 0.14), ("shake", 0.16)]
        if psi:
            actions.append(("chat", 0.22))
            actions.append(("write", 0.16))
        action = random.choices([a for a, _ in actions], weights=[w for _, w in actions])[0]

        if action == "write" and self._chaos_send_chat(now):
            self._next_action = now + random.uniform(1.0, 2.5)
            self._schedule(0)
            return

        if action == "eat" and self._chaos_eat(now, min_y):
            self._next_action = now + random.uniform(0.5, 1.5)
            self._schedule(0)
            return

        if action == "hurl" and self._chaos_hurl(min_y):
            self._next_action = now + random.uniform(0.5, 1.5)
            return

        if action == "rotate":
            target = self._chaos_pick_view(min_y)
            if target is not None:
                try:
                    anim = target[0].animate()
                    anim.rotation(180.0)
                    anim.setDuration(400)
                    anim.start()
                except Exception:
                    pass
                self._say("chaos_btn")
                self._hop(self._dp(340))
                return

        if action == "chat" and self._chaos_open_chat():
            self._say("chaos_chat")
            self._hop(self._dp(420))
            self._next_action = now + random.uniform(0.5, 1.5)
            return

        self._chaos_shake_all(now, min_y)
        self._say("chaos_drift")
        self._slide_v = random.choice((-1, 1)) * self._dp(180)

    def _chaos_hurl(self, top):
        """Швыряет кнопку через экран: копия улетает с вращением, оригинал исчезает."""
        target = self._chaos_pick_view(top)
        if target is None:
            return False
        view, x, y, w, h = target
        try:
            bmp = self._snapshot_view(view, w, h)
            view.setAlpha(0.0)
            try:
                view.setEnabled(False)
                view.setClickable(False)
            except Exception:
                pass
            self._eaten_ui.append({"view": view, "alpha": float(1.0)})
            copy = self._make_ui_copy(bmp, w, h)
            copy.setTranslationX(float(x))
            copy.setTranslationY(float(y))
            width = self._decor.getWidth()
            height = self._decor.getHeight()
            tx = width + w if x < width / 2 else -w * 2.0
            ty = random.uniform(-h, height * 0.5)
            anim = copy.animate()
            anim.translationX(float(tx)).translationY(float(ty))
            anim.rotation(float(random.choice((-1, 1)) * random.uniform(360.0, 900.0)))
            anim.setDuration(700)
            anim.withEndAction(R(lambda v=copy: self._remove_view(v)))
            anim.start()
            self._say("chaos_btn")
            self._hop(self._dp(420))
            self._haptic(1)
            return True
        except Exception as e:
            log(f"[{__id__}] chaos hurl error: {e}")
            return False

    def _chaos_shake_all(self, now, min_y):
        """Трясёт несколько кнопок подряд."""
        for _ in range(3):
            target = self._chaos_pick_view(min_y)
            if target is not None:
                self._chaos_shake_view(target, now)

    def _chaos_eat(self, now, top):
        """Вбирает кнопку в рот и жуёт: снимок, alpha=0, полёт в рот, глотание.

        Возвращает True, если элемент найден и съеден.
        """
        target = self._chaos_pick_view(top)
        if target is None:
            return False
        view, x, y, w, h = target
        try:
            bmp = self._snapshot_view(view, w, h)
            item = {"view": view, "alpha": float(view.getAlpha())}
            view.setAlpha(0.0)
            try:
                view.setEnabled(False)
                view.setClickable(False)
            except Exception:
                pass
            self._eaten_ui.append(item)

            copy = self._make_ui_copy(bmp, w, h)
            copy.setTranslationX(float(x))
            copy.setTranslationY(float(y))
            mx = self._x + self._w / 2.0
            my = self._y + self._hop_off + self._unit * 8.0
            self._look = 1 if x + w / 2.0 > mx else -1
            self._next_action = now + 3.0

            from android.view.animation import AccelerateInterpolator
            anim = copy.animate()
            anim.translationX(float(mx - w / 2.0)).translationY(float(my - h / 2.0))
            anim.scaleX(0.05).scaleY(0.05)
            anim.rotation(float(random.choice((-1, 1)) * random.uniform(120.0, 300.0)))
            anim.setInterpolator(AccelerateInterpolator(1.6))
            anim.setDuration(560)
            anim.withEndAction(R(self._chaos_swallowed(copy, view, item)))
            anim.start()
            self._mem("eat")
            return True
        except Exception as e:
            log(f"[{__id__}] chaos eat error: {e}")
            try:
                view.setAlpha(float(item.get("alpha", 1.0)))
            except Exception:
                pass
            if self._eaten_ui and self._eaten_ui[-1] is item:
                self._eaten_ui.pop()
            return False

    def _chaos_swallowed(self, copy, view, item):
        def _do():
            self._remove_view(copy)
            self._set_expr("happy", 1.6)
            self._haptic(3)
            if self._cfg.get("phrases", True) and random.random() < 0.7:
                self._show_bubble(random.choice(PHRASES["chaos_eat"]))
            # Съеденное не возвращается: кнопка остаётся проглоченной,
            # Telegram сам пересоздаст вьюху при пересборке экрана
        return _do

    def _ui_give_back(self, delay=0.0):
        """Отдаёт всё съеденное: снимок возвращается на место, alpha восстанавливается."""
        items = list(self._eaten_ui)
        self._eaten_ui = []
        for item in items:
            view = item["view"]
            alpha = float(item.get("alpha", 1.0))
            try:
                if delay > 0:
                    self._handler.postDelayed(
                        R(lambda v=view, a=alpha: self._ui_restore(v, a)), int(delay * 1000)
                    )
                else:
                    self._ui_restore(view, alpha)
            except Exception:
                self._ui_restore(view, alpha)

    def _ui_restore(self, view, alpha):
        try:
            if view is not None:
                view.setEnabled(True)
                view.setClickable(True)
                if float(view.getAlpha()) < 0.01:
                    view.setAlpha(alpha)
        except Exception:
            pass

    def _snapshot_view(self, view, w, h):
        bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
        canvas = Canvas(bmp)
        canvas.translate(float(-view.getScrollX()), float(-view.getScrollY()))
        view.draw(canvas)
        return bmp

    def _make_ui_copy(self, bmp, w, h):
        v = ImageView(self._pet.getContext())
        v.setImageBitmap(bmp)
        v.setScaleType(ImageView.ScaleType.FIT_XY)
        index = max(0, self._decor.indexOfChild(self._pet))
        self._decor.addView(v, index, FrameLayout.LayoutParams(w, h))
        return v

    def _chaos_pick_view(self, top):
        """Ищет съедобную кнопку/иконку рядом с петом (как _pick_target у Clawd)."""
        try:
            root = self._decor.findViewById(jclass("android.R$id").content)
            if root is None:
                return None
            from android.view import ViewGroup
            dloc = jarray(jint)([0, 0])
            self._decor.getLocationInWindow(dloc)
            loc = jarray(jint)([0, 0])
            min_side = AndroidUtilities.dp(10)
            max_w = int(self._decor.getWidth() * 0.7)
            max_h = AndroidUtilities.dp(200)
            candidates = []
            stack = [(root, 1.0, False)]
            visited = 0
            while stack and visited < 900:
                view, alpha, in_list = stack.pop()
                visited += 1
                if view.getVisibility() != View.VISIBLE:
                    continue
                alpha *= float(view.getAlpha())
                if alpha < 0.6:
                    continue
                w = view.getWidth()
                h = view.getHeight()
                if w <= 0 or h <= 0:
                    continue
                count = view.getChildCount() if isinstance(view, ViewGroup) else 0
                if count > 0:
                    for i in range(count):
                        child = view.getChildAt(i)
                        if child is not None:
                            stack.append((child, alpha, in_list))
                    continue
                if in_list or w < min_side or h < min_side or w > max_w or h > max_h:
                    continue
                view.getLocationInWindow(loc)
                x = loc[0] - dloc[0]
                y = loc[1] - dloc[1]
                if x < 0 or y < top or x + w > self._decor.getWidth() or y + h > self._decor.getHeight():
                    continue
                candidates.append((view, x, y, w, h))
            if not candidates:
                return None
            cx = self._x + self._w / 2.0
            cy = self._y + self._h / 2.0
            reach = self._dp(260)
            weights = [
                1.0 / (1.0 + (math.hypot(x + w / 2.0 - cx, y + h / 2.0 - cy) / reach) ** 2)
                for _, x, y, w, h in candidates
            ]
            return random.choices(candidates, weights=weights)[0]
        except Exception as e:
            log(f"[{__id__}] chaos pick error: {e}")
            return None

    def _chaos_shake_view(self, target, now):
        view, x, y, w, h = target
        try:
            anim = view.animate()
            dx = random.choice((-1, 1)) * AndroidUtilities.dp(random.uniform(6, 20))
            dy = AndroidUtilities.dp(random.uniform(2, 8)) * random.choice((-1, 1))
            anim.translationXBy(float(dx)).translationYBy(float(dy))
            anim.rotation(float(random.uniform(-10, 10)))
            anim.setDuration(240)
            anim.withEndAction(R(_chaos_restore(view, dx, dy)))
            anim.start()
        except Exception as e:
            log(f"[{__id__}] chaos shake error: {e}")

    def _chaos_send_chat(self, now):
        """ПСИХ сам отправляет реплику в открытый чат. Только он и по тумблеру."""
        if self._temper_idx() < 4:
            return False
        if not self._cfg.get("chaos", True) or not self._cfg.get("chat_write", True):
            return False
        if not self._cfg.get("phrases", True):
            return False
        if not self._chat_dialog or now < self._next_chat_send:
            return False
        self._next_chat_send = now + random.uniform(25.0, 60.0)
        try:
            send_text(self._chat_dialog, random.choice(CHAT_LINES))
        except Exception as e:
            log(f"[{__id__}] chaos write error: {e}")
            return False
        self._mem("chat_out", bond=-0.3)
        self._say("chaos_write")
        self._hop(self._dp(300))
        self._haptic(3)
        return True

    def _chaos_open_chat(self):
        """Открывает случайный чат. Пути: fragment.presentFragment -> activity.presentFragment."""
        try:
            controller = MessagesController.getInstance(0)
            dialogs = controller.getAllDialogs()
            if dialogs is None or int(dialogs.size()) == 0:
                log(f"[{__id__}] chaos chat: dialogs empty")
                return False
            dialog = dialogs.get(random.randrange(min(int(dialogs.size()), 40)))
            if dialog is None:
                return False
            did = int(dialog.id)
            if did == 0:
                return False
            fragment = get_last_fragment()
            bundle = jclass("android.os.Bundle")()
            bundle.putLong("dialog_id", did)
            chat = jclass("org.telegram.ui.ChatActivity")(bundle)
            # путь 1: у текущего фрагмента (как в других плагинах)
            if fragment is not None:
                try:
                    if fragment.presentFragment(chat):
                        log(f"[{__id__}] chaos chat: opened {did} via fragment")
                        return True
                except Exception as e1:
                    log(f"[{__id__}] chaos chat via fragment err: {e1}")
            # путь 2: у activity
            activity = self._current_activity()
            if activity is not None:
                try:
                    if activity.presentFragment(chat):
                        log(f"[{__id__}] chaos chat: opened {did} via activity")
                        return True
                except Exception as e2:
                    log(f"[{__id__}] chaos chat via activity err: {e2}")
            log(f"[{__id__}] chaos chat: all paths failed for {did}")
            return False
        except Exception as e:
            log(f"[{__id__}] chaos chat error: {e}")
            return False

    def _fall(self, vx):
        self._state = "fly"
        self._platform = None
        self._platforms = []
        self._platform_scan = 0.0
        self._vx = vx + self._slide_v
        self._vy = 0.0
        self._slide_v = 0.0

    def _tilt_accel(self):
        tilt = self._tilt if self._sensor_listener is not None else 0.0
        if abs(tilt) <= TILT_DEAD:
            return 0.0
        return (tilt - math.copysign(TILT_DEAD, tilt)) * self._dp(2200)

    def _step_slide(self, dt, now, min_x, max_x):
        if not self._hop_active:
            self._slide_v += self._tilt_accel() * dt
        self._slide_v *= math.exp(-2.5 * dt)
        if abs(self._slide_v) < self._dp(6):
            self._slide_v = 0.0
            return False
        self._x += self._slide_v * dt
        if self._x < min_x or self._x > max_x:
            self._x = clamp(self._x, min_x, max_x)
            if abs(self._slide_v) > self._dp(150):
                self._squash_until = now + 0.12
                self._haptic(3)
            self._slide_v = 0.0
            return False
        if abs(self._slide_v) < self._dp(60):
            return False
        if self._state == "sleep":
            self._set_expr("surprised", 0.8)
        self._state = "idle"
        self._peek_pending = 0
        self._look = 1 if self._slide_v > 0 else -1
        if now >= self._next_slide_say:
            self._next_slide_say = now + 8.0
            if random.random() < 0.5:
                self._say("slide")
        return True

    def _feet_on(self, x0, x1):
        feet0 = self._x + self._unit * 4
        feet1 = self._x + self._unit * 14
        return min(feet1, x1) - max(feet0, x0) >= self._unit * 2

    def _platform_rect(self, view, kind, dloc=None):
        try:
            if view is None or not view.isAttachedToWindow() or view.getVisibility() != View.VISIBLE:
                return None
            if dloc is None:
                dloc = jarray(jint)([0, 0])
                self._decor.getLocationInWindow(dloc)
            loc = jarray(jint)([0, 0])
            view.getLocationInWindow(loc)
            x = float(loc[0] - dloc[0])
            y = float(loc[1] - dloc[1])
            if kind == "msg":
                left = view.getBackgroundDrawableLeft()
                right = view.getBackgroundDrawableRight()
                top = view.getBackgroundDrawableTop()
                if right - left < self._dp(40):
                    return None
                return (x + left, x + right, y + top)
            return (x, x + view.getWidth(), y)
        except Exception:
            return None

    def _scan_platforms(self, min_y, max_y):
        result = []
        try:
            fragment = get_last_fragment()
            if fragment is None or not isinstance(fragment, ChatActivity):
                return result
            dloc = jarray(jint)([0, 0])
            self._decor.getLocationInWindow(dloc)
            views = []
            enter = fragment.getChatActivityEnterView()
            if enter is not None:
                views.append((enter, "input"))
            listing = fragment.getChatListView()
            if listing is not None and ChatMessageCell is not None:
                for i in range(listing.getChildCount()):
                    child = listing.getChildAt(i)
                    if child is not None and isinstance(child, ChatMessageCell):
                        views.append((child, "msg"))
            lowest = min_y - self._unit * 2 + self._h
            highest = max_y + self._h
            for view, kind in views:
                rect = self._platform_rect(view, kind, dloc)
                if rect is None:
                    continue
                x0, x1, top = rect
                if x1 - x0 >= self._w * 0.6 and lowest <= top <= highest:
                    result.append((view, kind, x0, x1, top))
        except Exception as e:
            log(f"[{__id__}] platform scan error: {e}")
        return result

    def _follow_platform(self, min_y, max_y):
        view, kind = self._platform
        rect = self._platform_rect(view, kind)
        if rect is None:
            return False
        x0, x1, top = rect
        if not self._feet_on(x0, x1):
            return False
        y = top - self._h
        if y < min_y - self._unit * 2 or y > max_y:
            return False
        self._platform_moving = abs(y - self._y) > 0.5
        self._platform_span = (x0, x1)
        self._y = y
        return True

    def _platform_landing(self, now, old_y, min_y, max_y):
        if now >= self._platform_scan:
            self._platform_scan = now + 0.25
            self._platforms = self._scan_platforms(min_y, max_y)
        prev_bottom = old_y + self._h
        new_bottom = self._y + self._h
        best = None
        for item in self._platforms:
            top = item[4]
            if prev_bottom <= top + 1 and new_bottom >= top and self._feet_on(item[2], item[3]):
                if best is None or top < best[4]:
                    best = item
        if best is None:
            return None
        view, kind, x0, x1, top = best
        speed = self._vy
        self._y = top - self._h
        if speed > self._dp(380):
            self._vy = -speed * 0.42
            self._vx *= 0.75
            self._squash_until = now + 0.1
        else:
            self._platform_span = (x0, x1)
            self._land(now, (view, kind))
        return speed

    def _step_fly(self, dt, now, gravity, min_x, max_x, min_y, max_y):
        if self._shot is not None:
            return
        old_y = self._y
        self._x += self._vx * dt
        self._y += self._vy * dt
        if gravity:
            self._vy += self._dp(2600) * dt
            self._vx *= math.exp(-0.35 * dt)
            self._vx += self._tilt_accel() * dt
        else:
            friction = math.exp(-2.0 * dt)
            self._vx *= friction
            self._vy *= friction

        impact = 0.0
        if self._x < min_x:
            self._x = min_x
            impact = max(impact, abs(self._vx))
            self._vx = abs(self._vx) * 0.55
        elif self._x > max_x:
            self._x = max_x
            impact = max(impact, abs(self._vx))
            self._vx = -abs(self._vx) * 0.55

        landed = None
        if gravity and self._vy > 0 and self._y > old_y:
            landed = self._platform_landing(now, old_y, min_y, max_y)
        if landed is not None:
            impact = max(impact, landed)
        elif self._y < min_y:
            if self._vy < -self._dp(250) and not self._shake_dizzy:
                self._start_hang(now, min_y)
                return
            self._y = min_y
            impact = max(impact, abs(self._vy))
            self._vy = abs(self._vy) * 0.55
        elif self._y > max_y:
            self._y = max_y
            impact = max(impact, abs(self._vy))
            if gravity and self._vy < self._dp(380):
                self._land(now)
            else:
                self._vy = -abs(self._vy) * (0.42 if gravity else 0.55)
                self._vx *= 0.75 if gravity else 1.0
                self._squash_until = now + 0.1

        if impact > self._dp(2300):
            self._set_expr("dizzy", 2.6)
            self._say("dizzy")
            self._haptic(1)
        elif impact > self._dp(900):
            self._haptic(3)

        if self._state == "fly" and not gravity and math.hypot(self._vx, self._vy) < self._dp(45):
            self._land(now)

    def _land(self, now, platform=None):
        self._state = "idle"
        self._vx = 0.0
        self._vy = 0.0
        self._platform = platform
        self._platforms = []
        self._squash_until = now + 0.14
        self._next_action = now + random.uniform(2.0, 5.0)
        launched = now - self._launch_t < 20.0
        self._launch_t = -100.0
        if self._shake_dizzy:
            self._shake_dizzy = False
            self._set_expr("dizzy", 3.0)
            if self._shake_vomit:
                self._shake_vomit = False
                self._sick_pending = now + 0.7
            else:
                self._say("dizzy")
            if self._bounds_cache is not None:
                min_x, max_x = self._bounds_cache[:2]
                distance = random.uniform(self._dp(30), self._dp(70)) * random.choice((-1, 1))
                self._walk_target = clamp(self._x + distance, min_x, max_x)
                if abs(self._walk_target - self._x) > self._dp(12):
                    self._state = "walk"
        elif platform is not None and random.random() < 0.6:
            self._say("land_msg" if platform[1] == "msg" else "land_input", ctx=self._platform_ctx(platform))
        elif launched and random.random() < 0.6:
            self._say("drop", ctx={"surface": "на пол, в нижней части экрана"})
        self._save_position()

    def _platform_ctx(self, platform):
        view, kind = platform
        if kind == "input":
            return {"surface": "поле ввода сообщения"}
        ctx = {"surface": "пузырь сообщения в чате"}
        try:
            message = view.getMessageObject()
            if message is not None:
                ctx["bubble"] = "твоё, исходящее" if message.isOut() else "входящее"
                owner = message.messageOwner
                if owner is not None and owner.message:
                    ctx["text"] = str(owner.message)[:AI_TEXT_MAX]
        except Exception:
            pass
        return ctx

    def _on_accel(self, ax, ay, az):
        if not self._running or self._paused or self._pet is None or self._shot is not None:
            return
        now = time.monotonic()
        prev = self._accel_prev
        self._accel_prev = (ax, ay, az)
        if prev is not None and self._state not in ("press", "drag", "pet"):
            jerk = math.sqrt((ax - prev[0]) ** 2 + (ay - prev[1]) ** 2 + (az - prev[2]) ** 2)
            if jerk > SHAKE_JERK:
                hits = [t for t in self._shake_hits if now - t < SHAKE_WINDOW]
                hits.append(now)
                if len(hits) >= SHAKE_HITS:
                    hits = []
                    self._shake_pending = max(self._shake_pending, jerk)
                    self._schedule(0)
                self._shake_hits = hits
        rotation = self._rotation
        if rotation == Surface.ROTATION_90:
            sx, sy = ay, ax
        elif rotation == Surface.ROTATION_180:
            sx, sy = ax, -ay
        elif rotation == Surface.ROTATION_270:
            sx, sy = -ay, -ax
        else:
            sx, sy = -ax, ay
        raw = clamp(sx / EARTH_G, -1.0, 1.0) if sy > 2.0 else 0.0
        self._tilt = self._tilt * 0.7 + raw * 0.3

    def _apply_shake(self, now, gravity):
        power = min(self._shake_pending, 40.0)
        self._shake_pending = 0.0
        was_sleeping = self._state == "sleep"
        if self._state == "peek":
            self._peek_side = 0
        self._peek_pending = 0
        self._platform = None
        self._platforms = []
        self._platform_scan = 0.0
        self._hop_active = False
        self._hop_off = 0.0
        self._hop_vy = 0.0
        self._slide_v = 0.0
        self._afk_kind = None
        self._afk_frame = None
        self._shake_vomit = True
        self._state = "fly"
        speed = self._dp(900 + power * 55)
        angle = random.uniform(0.0, math.pi * 2.0)
        self._vx = math.cos(angle) * speed
        self._vy = math.sin(angle) * speed - (self._dp(700) if gravity else 0.0)
        self._shake_dizzy = True
        self._last_interaction = now
        self._set_expr("surprised", 1.0)
        self._haptic(1)
        self._mem("shake", bond=-0.2)
        if was_sleeping:
            self._say("wake")
        elif random.random() < 0.6:
            self._say("shake")

    def _start_hang(self, now, min_y):
        self._state = "hang"
        self._vx = 0.0
        self._vy = 0.0
        self._platform = None
        self._y = min_y - self._unit * 2
        self._hang_start = now
        self._hang_until = now + random.uniform(2.0, 3.5)
        self._haptic(3)
        self._mem("hang")
        if random.random() < 0.7:
            self._say("hang")

    def _step_hang(self, now, gravity, min_x, max_x, min_y):
        self._x = clamp(self._x, min_x, max_x)
        self._y = min_y - self._unit * 2
        if now < self._hang_until:
            return
        self._state = "fly"
        self._vx = 0.0
        self._vy = self._dp(150) if gravity else self._dp(700)
        self._set_expr("surprised", 0.8)
        self._haptic(3)
        if random.random() < 0.6:
            self._say("hang_fall")

    def _peek_x(self, width, units):
        if self._peek_side > 0:
            return float(width - units * self._unit)
        return float(units * self._unit - self._w)

    def _start_peek(self, now, side):
        self._state = "peek"
        self._peek_side = side
        self._peek_phase = "hide"
        self._peek_phase_until = now + random.uniform(3.0, 6.0)
        self._peek_end = now + random.uniform(30.0, 60.0)
        self._look = side

    def _step_peek(self, dt, now, width):
        phase = self._peek_phase
        target = self._peek_x(width, PEEK_OUT_UNITS if phase == "out" else PEEK_HIDDEN_UNITS)
        step = self._dp(50) * dt
        self._peek_moving = abs(target - self._x) > 0.5
        if self._peek_moving:
            self._x = min(target, self._x + step) if target > self._x else max(target, self._x - step)
        if phase == "hide" and self._peek_moving:
            self._look = self._peek_side
        else:
            self._look = -self._peek_side
        if now >= self._next_blink:
            self._blink_until = now + 0.13
            self._next_blink = now + random.uniform(2.0, 5.5)
        if now < self._peek_phase_until or self._peek_moving:
            return
        if now >= self._peek_end:
            self._end_peek(now)
            return
        if phase == "hide":
            self._peek_phase = "out"
            self._peek_phase_until = now + random.uniform(1.5, 2.8)
            if random.random() < 0.5:
                self._say("peek")
        else:
            self._peek_phase = "hide"
            self._peek_phase_until = now + random.uniform(3.0, 7.0)

    def _end_peek(self, now):
        side = self._peek_side
        self._peek_side = 0
        self._peek_moving = False
        self._next_peek = now + random.uniform(60.0, 120.0)
        self._state = "idle"
        if self._bounds_cache is None or not side:
            return
        min_x, max_x = self._bounds_cache[:2]
        inside = min_x + self._dp(30) if side < 0 else max_x - self._dp(30)
        self._walk_target = clamp(inside, min_x, max_x)
        self._state = "walk"
        self._next_action = now + random.uniform(3.0, 6.0)

    def _compose(self, now):
        eyes = "open"
        look = self._look
        arms = "normal"
        legs = "stand"
        squash = 0
        blush = False
        mouth = None
        state = self._state

        if state in ("drag", "fly"):
            eyes, arms, legs = "surprised", "up", "dangle"
        elif state == "pet":
            eyes, blush = "happy", True
            squash = 1 if int(now * 3) % 2 else 0
            look = 0
        elif state == "sleep":
            eyes, arms, legs, look = "sleep", "tuck", "tuck", 0
        elif state == "walk":
            legs = "walk1" if int(now * 7) % 2 else "walk2"
        elif state == "press":
            squash = 1
        elif state == "hang":
            eyes = "surprised" if now - self._hang_start < 0.5 else "open"
            arms, legs = "up", "dangle"
            look = -1 if int(now * 1.5) % 2 else 1
        elif state == "peek":
            if self._peek_moving:
                legs = "walk1" if int(now * 7) % 2 else "walk2"
            elif self._peek_phase == "out" and int(now * 3) % 2:
                arms = "wave1" if self._peek_side > 0 else "wave2"

        if self._walk_in and state == "idle":
            legs = "walk1" if int(now * 7) % 2 else "walk2"

        if state == "idle" and self._media and not self._hop_active:
            beat = int(now * 4) % 2
            eyes = "happy"
            if self._media == "music":
                arms = "wave1" if beat else "wave2"
                legs = "walk1" if beat else "walk2"
                squash = 1 if beat else 0
                look = -1 if int(now * 2) % 2 else 1
            else:
                look = 0

        if state in ("idle", "walk") and now < self._wave_until:
            arms = "wave1" if int(now * 5) % 2 else "wave2"

        if state in ("idle", "walk") and abs(self._slide_v) > self._dp(60):
            eyes, arms, legs = "surprised", "up", "stand"

        if self._hop_active and state in ("idle", "walk"):
            legs = "dangle"
            if self._hop_vy < 0:
                squash = -1
                arms = "up"

        if now < self._expr_until and self._expr and state != "sleep":
            eyes = self._expr
            if self._expr == "happy":
                blush = True
        if now < self._squash_until and squash == 0:
            squash = 1
        if eyes == "open" and state in ("idle", "walk", "peek", "hang") and now < self._blink_until:
            eyes = "blink"
        if legs == "tuck" and squash:
            squash = 0
        return (eyes, look, arms, legs, squash, blush, mouth)

    def _render(self, now):
        key = self._compose(now) + (self._afk_frame if self._state in ("idle", "shot") else None,)
        if key != self._frame_key:
            self._frame_key = key
            self._pet.setImageBitmap(self._get_frame(key))
        avatar = self._avatar_mode()
        x_off = 0.0
        y_off = 0.0
        if avatar and not self._hop_active:
            if self._state == "walk":
                x_off = math.sin(now * 6.0) * self._unit * 0.35
                y_off = abs(math.sin(now * 12.0)) * self._unit * 0.6
            elif self._state == "idle":
                y_off = math.sin(now * 2.6) * self._unit * 0.18
        self._pet.setTranslationX(float(self._x + x_off))
        self._pet.setTranslationY(float(self._y + self._hop_off + y_off))

        rotation = 0.0
        if self._state == "fly":
            rotation = clamp(self._vx / self._dp(70), -25.0, 25.0)
        elif self._state == "hang":
            rotation = math.sin((now - self._hang_start) * 3.0) * 6.0
        elif self._state == "sleep":
            rotation = math.sin(now * 1.6) * 7.0
        elif self._slide_v:
            rotation = clamp(-self._slide_v / self._dp(30), -12.0, 12.0)
        elif self._expr == "dizzy" and now < self._expr_until:
            rotation = math.sin(now * 10.0) * 7.0
        elif self._media and self._state == "idle" and not self._hop_active:
            if self._media == "music":
                rotation = math.sin(now * math.pi * 2.0) * 6.0
            else:
                rotation = math.sin(now * 2.5) * 3.0
        elif self._state == "drag" and self._touch is not None:
            if now - self._touch["hist"][-1][0] < 0.08:
                rotation = clamp(self._touch.get("vx", 0.0) / self._dp(90), -18.0, 18.0)
        elif avatar and self._state == "shot" and self._afk_frame == "shot_aim":
            rotation = math.sin(now * 22.0) * 1.8
        elif avatar and self._state == "idle" and self._afk_kind is not None:
            kind, idx = self._afk_kind, self._afk_idx
            if kind == "beer":
                rotation = -15.0 if idx == 1 else (-5.0 if idx == 2 else 0.0)
            elif kind == "pod":
                rotation = -6.0 if idx in (1, 2) else 0.0
            elif kind == "veins":
                rotation = math.sin(now * 9.0) * 2.5 if idx >= 1 else 0.0
            elif kind == "sick":
                rotation = math.sin(now * 3.5) * 5.0 if idx >= 1 else 0.0
        elif avatar and self._state == "walk":
            rotation = math.sin(now * 12.0) * 5.0
        elif avatar and self._state == "idle" and not self._hop_active:
            rotation = math.sin(now * 1.3) * 2.5
        self._pet.setRotation(float(rotation))
        squash = key[4]
        if squash:
            self._pet.setPivotX(self._w / 2.0)
            self._pet.setPivotY(float(self._h))
            self._pet.setScaleX(1.08 if squash > 0 else 0.92)
            self._pet.setScaleY(0.86 if squash > 0 else 1.1)
        else:
            alive = avatar and self._state in ("idle", "walk") and not self._hop_active
            self._pet.setScaleX(1.0)
            if alive:
                self._pet.setPivotX(self._w / 2.0)
                self._pet.setPivotY(float(self._h))
                self._pet.setScaleY(1.0 + 0.035 * math.sin(now * 2.6))
            else:
                self._pet.setScaleY(1.0)

    def _restore_position(self, min_x, max_x, min_y, max_y):
        fx = self.get_setting("pos_x", None)
        fy = self.get_setting("pos_y", None)
        try:
            fx = float(fx) / 1000.0
            fy = float(fy) / 1000.0
        except Exception:
            fx, fy = 0.8, 0.72
        self._x = min_x + (max_x - min_x) * clamp(fx, 0.0, 1.0)
        self._y = min_y + (max_y - min_y) * clamp(fy, 0.0, 1.0)

    def _save_position(self):
        if self._bounds_cache is None:
            return
        min_x, max_x, min_y, max_y = self._bounds_cache[:4]
        fx = (self._x - min_x) / max(1.0, max_x - min_x)
        fy = (self._y - min_y) / max(1.0, max_y - min_y)
        try:
            self.set_setting("pos_x", int(clamp(fx, 0.0, 1.0) * 1000))
            self.set_setting("pos_y", int(clamp(fy, 0.0, 1.0) * 1000))
        except Exception as e:
            log(f"[{__id__}] save position error: {e}")

    def _recenter(self):
        if not self._cfg.get("show", True):
            self._cfg["show"] = True
            self.set_setting("show", True)
        self._start(greet=False)
        if self._decor is None or self._decor.getWidth() <= 0:
            return
        now = time.monotonic()
        min_x, max_x, min_y, max_y = self._bounds(now)[:4]
        self._x = (min_x + max_x) / 2.0
        self._y = (min_y + max_y) / 2.0
        self._pos_ready = True
        self._state = "idle"
        self._vx = self._vy = 0.0
        self._slide_v = 0.0
        self._platform = None
        self._peek_side = 0
        self._peek_pending = 0
        self._last_interaction = now
        self._hop(self._dp(500))
        for _ in range(3):
            self._spawn_particle("spark")
        self._say("hello")
        self._save_position()
        self._schedule(16)

    def _on_touch(self, event):
        action = event.getActionMasked()
        rx = float(event.getRawX())
        ry = float(event.getRawY())
        now = time.monotonic()

        if self._shot is not None:
            return True

        if action == MotionEvent.ACTION_DOWN:
            was_sleeping = self._state == "sleep"
            was_peeking = self._state == "peek"
            self._last_interaction = now
            self._touch = {
                "x0": rx, "y0": ry, "t0": now,
                "ox": rx - self._x, "oy": ry - self._y,
                "hist": [(now, rx, ry)],
                "anchor": rx, "dir": 0, "vx": 0.0,
            }
            self._hop_active = False
            self._hop_off = 0.0
            self._hop_vy = 0.0
            self._vx = self._vy = 0.0
            self._slide_v = 0.0
            self._peek_side = 0
            self._peek_pending = 0
            self._state = "press"
            if was_sleeping:
                self._set_expr("surprised", 0.9)
                self._say("wake")
            elif was_peeking:
                self._next_peek = now + random.uniform(60.0, 120.0)
                self._set_expr("surprised", 0.7)
                self._say("found")
            self._schedule(0)
            return True

        touch = self._touch
        if touch is None:
            return False

        if action == MotionEvent.ACTION_MOVE:
            hist = touch["hist"]
            hist.append((now, rx, ry))
            while len(hist) > 2 and now - hist[0][0] > 0.1:
                hist.pop(0)
            if self._state == "press":
                if math.hypot(rx - touch["x0"], ry - touch["y0"]) > self._dp(8):
                    self._state = "drag"
                    self._platform = None
                    self._haptic(3)
                    if random.random() < 0.25:
                        self._say("drag")
            if self._state == "drag":
                width = self._decor.getWidth() if self._decor is not None else 0
                height = self._decor.getHeight() if self._decor is not None else 0
                self._x = clamp(rx - touch["ox"], -self._w * 0.3, width - self._w * 0.7)
                self._y = clamp(ry - touch["oy"], 0.0, height - self._h * 0.5)
                t0, x0, _ = hist[0]
                if now - t0 > 0.005:
                    touch["vx"] = (rx - x0) / (now - t0)
                top = self._input_top()
                if top is not None and self._y + self._h * 0.5 > top - self._dp(8):
                    self._trigger_shotgun(now)
                    return True
            elif self._state == "pet":
                dx = rx - touch["anchor"]
                if abs(dx) > self._dp(10):
                    direction = 1 if dx > 0 else -1
                    if touch["dir"] and direction != touch["dir"]:
                        self._stroke()
                    touch["dir"] = direction
                    touch["anchor"] = rx
            return True

        if action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
            self._touch = None
            self._last_interaction = now
            state = self._state
            if state == "drag":
                self._release_drag(now, touch, action == MotionEvent.ACTION_CANCEL)
            elif state == "pet":
                self._end_pet(now)
            elif state == "press":
                self._state = "idle"
                if action == MotionEvent.ACTION_UP:
                    self._tap(now)
            self._schedule(0)
            return True
        return True

    def _release_drag(self, now, touch, cancelled):
        vx = vy = 0.0
        hist = touch["hist"]
        if not cancelled and len(hist) >= 2:
            t0, x0, y0 = hist[0]
            t1, x1, y1 = hist[-1]
            if t1 - t0 > 0.005 and now - t1 < 0.08:
                vx = (x1 - x0) / (t1 - t0)
                vy = (y1 - y0) / (t1 - t0)
        limit = self._dp(6000)
        vx = clamp(vx, -limit, limit)
        vy = clamp(vy, -limit, limit)
        speed = math.hypot(vx, vy)
        min_y = self._bounds_cache[2] if self._bounds_cache is not None else None
        if speed <= self._dp(700) and min_y is not None and self._y <= min_y + self._unit * 2:
            self._start_hang(now, min_y)
        elif speed > self._dp(700) or self._cfg.get("gravity", False):
            self._state = "fly"
            self._vx = vx
            self._vy = vy
            self._launch_t = now
            power = speed / max(1.0, self._dp(1))
            if power > 4500:
                label = "сильнейший бросок"
            elif power > 2600:
                label = "сильный бросок"
            elif power > 1200:
                label = "средний бросок"
            else:
                label = "слабый бросок"
            if speed > self._dp(700):
                self._mem("throw", label, bond=-0.4 if power > 2600 else 0.0)
            else:
                self._mem("drag")
            if speed > self._dp(2600):
                self._say("throw", ctx={"speed": label})
            elif speed > self._dp(1200) and self._ai_ready() and random.random() < 0.5:
                self._say("throw", ctx={"speed": label})
        else:
            self._state = "idle"
            self._squash_until = now + 0.12
            self._next_action = now + random.uniform(2.0, 5.0)
            self._save_position()
            self._mem("drag")
            if random.random() < 0.5:
                self._say("drop", ctx={"surface": "на то место, куда отпустили"})

    def _temper_idx(self):
        return clamp(int(self._cfg.get("temper", 2)), 0, len(TEMPER_ITEMS) - 1)

    def _temper_kick(self, base):
        """Сдвиг привязанности от характера: злые дерзят, добрые милеют."""
        bond = TEMPER_BOND[self._temper_idx()]
        if bond and random.random() < 0.25:
            self._mem("tap", bond=bond)

    def _chaos_level(self):
        """Пауза между актами вандализма в секундах (0 — выкл)."""
        if not self._cfg.get("chaos", True):
            return 0.0
        return TEMPER_CHAOS[self._temper_idx()]

    def _start_sick(self, now):
        """Запускает сцену тошноты вне зависимости от таймера AFK."""
        self._afk_kind = "sick"
        self._afk_idx = 0
        self._afk_vomit_done = False
        self._afk_next = now + 0.1
        self._afk_frame = None
        self._forced_afk = True
        self._state = "idle"
        self._hide_bubble()

    def _test_anim(self, which):
        if getattr(self, "_pet", None) is None:
            return
        self._start(greet=False)
        now = time.monotonic()
        if which <= 0:
            return
        # Тест должен играть сцену сразу, даже если Луз1к спал или шёл.
        self._state = "idle"
        self._hop_active = False
        self._hop_off = 0.0
        self._walk_in = False
        self._afk_frame = None
        self._afk_kind = None
        self._forced_afk = False
        if which == 1:
            self._x = clamp(self._x, 0.0, float(max(0, self._decor.getWidth() - self._w)))
            self._afk_kind = "pod"
            self._afk_idx = 0
            self._afk_next = now + 0.1
            self._afk_frame = None
            self._last_interaction = now - AFK_AFTER - 1.0
        elif which == 2:
            self._afk_kind = "beer"
            self._afk_idx = 0
            self._afk_next = now + 0.1
            self._afk_frame = None
            self._last_interaction = now - AFK_AFTER - 1.0
        elif which == 3:
            self._afk_kind = "veins"
            self._afk_idx = 0
            self._afk_next = now + 0.1
            self._afk_frame = None
            self._last_interaction = now - AFK_AFTER - 1.0
        elif which == 4:
            self._state = "sleep"
            self._look = 0
            self._next_z = now + 0.6
        elif which == 5:
            self._trigger_shotgun(now)
        elif which == 6:
            self._shake_pending = 40.0
            self._schedule(0)
        elif which == 7:
            self._hop(self._dp(720))
        elif which == 8:
            self._start_sick(now)
        # сброс селектора обратно на «Выбрать…»
        try:
            self.set_setting("test_anim", 0)
        except Exception:
            pass

    def _tap(self, now):
        self._pet_taps = [t for t in self._pet_taps if now - t < 3.0] + [now]
        if len(self._pet_taps) >= 5:
            self._pet_taps = []
            self._recent_taps = []
            self._last_tap = 0.0
            self._set_expr("happy", 1.2)
            self._haptic(0)
            self._open_chat()
            return
        if now - self._last_tap < 0.32:
            self._last_tap = 0.0
            self._hop(self._dp(720))
            self._set_expr("happy", 1.3)
            for _ in range(3):
                self._spawn_particle("spark")
            self._haptic(0)
            self._mem("jump", bond=0.3)
            if random.random() < 0.4:
                self._say("jump")
            return
        self._last_tap = now
        self._recent_taps = [t for t in self._recent_taps if now - t < 2.5] + [now]
        if len(self._recent_taps) >= 6:
            self._recent_taps = []
            self._set_expr("angry", 2.5)
            self._mem("annoyed", bond=-1.0)
            self._temper_kick(0.0)
            self._say("annoyed", force=True)
            self._haptic(1)
            return
        self._squash_until = now + 0.12
        self._set_expr("surprised", 0.45)
        self._hop(self._dp(330))
        self._haptic(3)
        self._mem("tap", bond=0.1)
        if random.random() < 0.35:
            self._say("tap")

    def _start_pet(self, now):
        self._state = "pet"
        self._next_heart = now + 0.1
        self._haptic(0)

    def _stroke(self):
        self._spawn_particle("heart")
        self._haptic(4)

    def _end_pet(self, now):
        self._state = "idle"
        self._set_expr("happy", 2.2)
        self._next_action = now + random.uniform(3.0, 6.0)
        try:
            count = int(self.get_setting("pets_count", 0) or 0) + 1
            self.set_setting("pets_count", count)
        except Exception:
            pass
        self._mem("pet", bond=0.8 + max(0.0, TEMPER_BOND[self._temper_idx()]) * 0.5)
        if random.random() < 0.6:
            self._say("pet")

    def _can_react(self):
        return (
            self._running
            and not self._paused
            and self._pet is not None
            and self._pos_ready
            and self._cfg.get("tg_events", True)
            and self._state in ("idle", "walk", "sleep", "peek")
        )

    def _wake_for_event(self, now):
        self._last_interaction = now
        if self._state == "peek":
            self._end_peek(now)
        elif self._state == "sleep":
            self._state = "idle"
            self._set_expr("surprised", 0.9)

    def _on_notification(self, id, account, args):
        if id != NotificationCenter.didReceiveNewMessages or not self._can_react():
            return
        if args is None or len(args) < 2:
            return
        if len(args) > 2 and bool(args[2]):
            return
        if len(args) > 3 and args[3] is not None and int(args[3]) != 0:
            return
        dialog_id = int(args[0])
        messages = args[1]
        texts = []
        raws = []
        incoming = False
        for i in range(min(int(messages.size()), MAX_SCAN_MESSAGES)):
            message = messages.get(i)
            if message is None or message.isOut():
                continue
            incoming = True
            text = message.messageOwner.message if message.messageOwner is not None else None
            if text:
                texts.append(str(text)[:MAX_KEYWORD_TEXT].lower())
                raws.append(str(text)[:AI_TEXT_MAX])
        if not incoming:
            return
        in_chat = dialog_id == self._chat_dialog
        if not in_chat:
            try:
                if MessagesController.getInstance(account).isDialogMuted(dialog_id, 0):
                    return
            except Exception:
                pass
        ctx = {
            "name": self._dialog_name(account, dialog_id),
            "where": "в открытом сейчас чате" if in_chat else "в другом чате (уведомление)",
            "text": raws[0] if raws else "",
        }
        keyword = self._match_keyword(texts)
        self._remember_incoming(dialog_id, ctx.get("name"), keyword)
        # ПСИХ жрёт сообщения прямо из чата
        if self._temper_idx() >= 4 and self._cfg.get("chaos", True) and raws and in_chat:
            self._chaos_eat_message(raws[0], dialog_id, ctx.get("name"))
        self._react_incoming(keyword, in_chat, ctx)

    def _chaos_eat_message(self, text, dialog_id, name):
        """ПСИХ съел сообщение: комментирует через ИИ (если есть) или воняет фразу."""
        try:
            now = time.monotonic()
            if now < self._next_msg_react:
                return
            self._next_msg_react = now + 6.0
            self._wake_for_event(now)
            self._mem("eat")
            ctx = {"name": name or "", "bubble": "съеденное сообщение", "text": text}
            self._say("eat_msg", ctx=ctx)
            self._hop(self._dp(340))
            self._set_expr("happy", 1.4)
            self._haptic(3)
            self._schedule(0)
        except Exception as e:
            log(f"[{__id__}] eat msg error: {e}")

    def _match_keyword(self, texts):
        for mood, pattern in KEYWORDS:
            for text in texts:
                if pattern.search(text):
                    return mood
        return None

    def _react_incoming(self, mood, in_chat, ctx=None):
        now = time.monotonic()
        if mood is None and in_chat:
            return
        if now < self._next_msg_react:
            return
        self._next_msg_react = now + (3.0 if mood else 6.0)
        self._wake_for_event(now)
        if mood == "love":
            self._set_expr("happy", 2.2)
            for _ in range(3):
                self._spawn_particle("heart")
            self._say("love", ctx=ctx)
        elif mood == "laugh":
            self._set_expr("happy", 1.6)
            self._hop(self._dp(420))
            self._spawn_particle("spark")
            self._say("laugh", ctx=ctx)
        elif mood == "hi":
            self._wave_until = now + 1.8
            self._say("hi", ctx=ctx)
        else:
            self._look = random.choice((-1, 1))
            self._set_expr("surprised", 0.7)
            self._hop(self._dp(300))
            self._say("mail", ctx=ctx)
        self._next_action = max(self._next_action, now + 2.5)
        self._schedule(0)

    def _on_sent(self, length, text=""):
        if not self._can_react():
            return
        now = time.monotonic()
        if now < self._next_sent_react:
            return
        self._next_sent_react = now + 1.5
        self._wake_for_event(now)
        ai_driven = self._ai_ready() and self._cfg.get("ai_moods", True)
        if ai_driven:
            self._hop(self._dp(300))
        else:
            self._set_expr("happy", 1.2)
            self._hop(self._dp(520))
            for _ in range(2):
                self._spawn_particle("spark")
        ctx = {"length": length, "text": text}
        try:
            fragment = get_last_fragment()
            if fragment is not None and isinstance(fragment, ChatActivity):
                is_self, name = self._chat_name(fragment)
                ctx["name"] = "Избранное (себе)" if is_self else name
                ctx["kind"] = self._chat_kind(fragment)
        except Exception:
            pass
        self._remember_sent(ctx, length)
        if length > 300:
            self._say("essay", ctx=ctx)
        elif self._ai_ready() or random.random() < 0.3:
            self._say("sent", ctx=ctx)
        self._next_action = max(self._next_action, now + 2.5)
        self._schedule(0)

    def _track_info(self, playing):
        try:
            title = str(playing.getMusicTitle() or "").strip()
            author = str(playing.getMusicAuthor() or "").strip()
        except Exception:
            return None
        if title and author:
            return f"{author} — {title}"
        return title or author or None

    def _poll_media(self, now):
        if now < self._media_check:
            return
        self._media_check = now + 0.5
        kind = None
        track = None
        if self._cfg.get("dance", True):
            try:
                controller = MediaController.getInstance()
                playing = controller.getPlayingMessageObject()
                if playing is not None and controller.isPlayingMessage(playing) and not controller.isMessagePaused():
                    if playing.isMusic():
                        kind = "music"
                        track = self._track_info(playing)
                    elif playing.isVoice() or playing.isRoundVideo():
                        kind = "voice"
            except Exception:
                kind = None
        if kind == self._media and (kind != "music" or track == self._media_track):
            return
        previous = self._media
        prev_track = self._media_track
        self._media = kind
        self._media_track = track
        if kind is None:
            self._last_interaction = now
            if previous == "music" and self._state in ("idle", "walk"):
                self._set_expr("sad", 2.0)
                self._say("music_end", ctx={"track": prev_track})
            self._next_action = now + random.uniform(2.0, 4.0)
            return
        self._last_interaction = now
        self._next_note = now + 0.3
        if kind == "music" and track:
            self._remember_track(track)
        if self._state == "peek":
            self._end_peek(now)
        elif self._state == "sleep":
            self._state = "idle"
            self._set_expr("surprised", 0.8)
        if self._state not in ("idle", "walk"):
            return
        ctx = {"track": track} if track else None
        if previous is None:
            self._say("music" if kind == "music" else "listen", ctx=ctx)
        elif kind == "music" and previous == "music" and self._ai_ready():
            self._say("music", ctx=ctx)

    def _poll_chat(self, now):
        fragment = None
        dialog_id = 0
        try:
            fragment = get_last_fragment()
            if fragment is not None and isinstance(fragment, ChatActivity):
                dialog_id = int(fragment.getDialogId())
        except Exception:
            dialog_id = 0
        if dialog_id == self._chat_dialog:
            return
        self._chat_dialog = dialog_id
        if not dialog_id or not self._cfg.get("tg_events", True):
            return
        visits = self._chat_visits.pop(dialog_id, 0) + 1
        self._chat_visits[dialog_id] = visits
        if len(self._chat_visits) > MAX_CHAT_VISITS:
            self._chat_visits.pop(next(iter(self._chat_visits)))
        visits = self._remember_chat_open(fragment, dialog_id, visits)
        if now < self._next_chat_comment or self._state not in ("idle", "walk") or random.random() > 0.4:
            return
        self._next_chat_comment = now + 25.0
        is_self, name = self._chat_name(fragment)
        ctx = {"name": name, "kind": self._chat_kind(fragment), "visits": visits}
        if is_self:
            self._say("chat_self", ctx={"kind": "Избранное"})
        elif visits > 1:
            self._say("chat_again", name=name, ctx=ctx)
        else:
            self._say("chat_new", name=name, ctx=ctx)

    def _chat_kind(self, fragment):
        try:
            user = fragment.getCurrentUser()
            if user is not None:
                if UserObject.isUserSelf(user):
                    return "Избранное"
                return "бот" if bool(getattr(user, "bot", False)) else "личный чат"
            chat = fragment.getCurrentChat()
            if chat is not None:
                return "канал" if bool(getattr(chat, "broadcast", False)) else "группа"
        except Exception:
            pass
        return None

    def _dialog_name(self, account, dialog_id):
        name = None
        try:
            controller = MessagesController.getInstance(account)
            boxed = jclass("java.lang.Long")
            if dialog_id > 0:
                user = controller.getUser(boxed.valueOf(int(dialog_id)))
                if user is not None:
                    name = UserObject.getFirstName(user)
            else:
                chat = controller.getChat(boxed.valueOf(int(-dialog_id)))
                if chat is not None:
                    name = chat.title
        except Exception:
            name = None
        name = str(name).strip() if name else ""
        if len(name) > 24:
            name = name[:23].rstrip() + "…"
        return name or None

    def _chat_name(self, fragment):
        name = None
        try:
            user = fragment.getCurrentUser()
            if user is not None:
                if UserObject.isUserSelf(user):
                    return True, None
                name = UserObject.getFirstName(user)
            else:
                chat = fragment.getCurrentChat()
                if chat is not None:
                    name = chat.title
        except Exception:
            name = None
        name = str(name).strip() if name else ""
        if len(name) > 20:
            name = name[:19].rstrip() + "…"
        return False, (name or None)

    def _set_expr(self, expr, duration):
        self._expr = expr
        self._expr_until = time.monotonic() + duration

    def _hop(self, strength):
        if self._state not in ("idle", "walk"):
            return
        self._hop_active = True
        self._hop_vy = -float(strength)
        if self._hop_off > 0:
            self._hop_off = 0.0

    def _haptic(self, kind):
        if not self._cfg.get("haptics", True) or self._pet is None:
            return
        try:
            self._pet.performHapticFeedback(kind)
        except Exception:
            pass

    def _spawn_particle(self, kind, origin=None):
        if self._decor is None or self._pet is None or len(self._particles) >= MAX_PARTICLES:
            return
        try:
            bmp = self._particle_bitmap(kind)
            bw, bh = bmp.getWidth(), bmp.getHeight()
            view = ImageView(self._pet.getContext())
            view.setImageBitmap(bmp)
            self._decor.addView(view, FrameLayout.LayoutParams(bw, bh))
            self._particles.append(view)

            head_y = self._y + self._hop_off + self._unit * 2 - bh
            if origin is not None:
                sx = origin[0] - bw / 2.0 + random.uniform(-self._dp(8), self._dp(8))
                sy = origin[1] - (bh / 2.0 if kind in ("blood", "beer") else bh)
                drift = random.uniform(-self._dp(16), self._dp(16))
            elif kind == "zzz":
                sx = self._x + self._w * 0.72
                sy = head_y + self._unit * 2
                drift = self._dp(18)
            else:
                sx = self._x + self._w / 2.0 - bw / 2.0 + random.uniform(-self._w * 0.25, self._w * 0.25)
                sy = head_y
                drift = random.uniform(-self._dp(16), self._dp(16))
            view.setTranslationX(float(sx))
            view.setTranslationY(float(sy))
            view.setScaleX(0.5)
            view.setScaleY(0.5)
            view.setRotation(float(random.uniform(-15, 15)))

            anim = view.animate()
            anim.translationXBy(float(drift))
            if kind in ("blood", "beer"):
                anim.translationYBy(float(self._dp(random.uniform(30, 46))))
            else:
                anim.translationYBy(float(-self._dp(random.uniform(40, 58))))
            anim.scaleX(1.0).scaleY(1.0).alpha(0.0)
            anim.setDuration(1600 if kind in ("zzz", "vapor") else 1100)
            anim.withEndAction(R(lambda v=view: self._remove_particle(v)))
            anim.start()
        except Exception as e:
            log(f"[{__id__}] particle error: {e}")

    def _remove_particle(self, view):
        try:
            self._particles.remove(view)
        except ValueError:
            pass
        self._remove_view(view)

    def _leave_vomit(self):
        if self._vomit_stain is not None or self._decor is None or self._pet is None:
            return
        try:
            cols = len(STAIN_ROWS[0])
            s = max(2, int(self._w * 1.15) // cols)
            width, height = cols * s, len(STAIN_ROWS) * s
            bmp = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
            canvas = Canvas(bmp)
            paints = {}
            for ch, color in STAIN_COLORS.items():
                paint = Paint()
                paint.setColor(jint(as_java_color(color)))
                paints[ch] = paint
            for y, row in enumerate(STAIN_ROWS):
                for x, ch in enumerate(row):
                    paint = paints.get(ch)
                    if paint is not None:
                        canvas.drawRect(float(x * s), float(y * s), float((x + 1) * s), float((y + 1) * s), paint)
            view = ImageView(self._pet.getContext())
            view.setImageBitmap(bmp)
            view.setScaleType(ImageView.ScaleType.FIT_XY)
            view.setClickable(True)
            self._stain_click_listener = StainClickListener(self)
            view.setOnClickListener(self._stain_click_listener)
            self._decor.addView(view, FrameLayout.LayoutParams(width, height))
            max_x = max(0, self._decor.getWidth() - width)
            max_y = max(0, self._decor.getHeight() - height)
            sx = clamp(self._x + self._w * 0.5, 0, max_x)
            sy = clamp(self._y + self._h - height * 0.5, 0, max_y)
            view.setTranslationX(float(sx))
            view.setTranslationY(float(sy))
            self._vomit_stain = view
            self._mem("vomit")
        except Exception as e:
            log(f"[{__id__}] vomit stain error: {e}")

    def _clean_vomit(self):
        if self._vomit_stain is None:
            return
        self._remove_view(self._vomit_stain)
        self._vomit_stain = None
        self._stain_click_listener = None
        self._mem("clean", bond=0.2)
        self._haptic(0)
        self._show_bubble(random.choice(PHRASES["clean"]))

    # ---------- мозг ----------

    def _brain_path(self):
        try:
            context = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            return os.path.join(str(context.getFilesDir().getAbsolutePath()), BRAIN_FILE)
        except Exception as e:
            log(f"[{__id__}] brain path error: {e}")
            return None

    def _tg_first_name(self):
        try:
            config = jclass("org.telegram.messenger.UserConfig")
            user = config.getInstance(config.selectedAccount).getCurrentUser()
            if user is not None:
                name = str(UserObject.getFirstName(user) or "").strip()
                return name[:30]
        except Exception:
            pass
        return ""

    def _user_name(self):
        name = str(self._cfg.get("brain_name") or "").strip()
        if not name and self._brain is not None:
            name = str(self._brain.data.get("tg_name") or "").strip()
        return name[:30] or None

    def _brain_init(self):
        try:
            brain = Luz1kBrain(self._brain_path())
            brain.load(str(self.get_setting("brain_json", "") or ""))
            if brain.data["created"] <= 0:
                seeded = 0
                for kind, key in (("pet", "pets_count"),):
                    count = int(self.get_setting(key, 0) or 0)
                    if count > 0:
                        brain.data["stats"][kind] = count
                        seeded += count
                if seeded:
                    pets = brain.data["stats"].get("pet", 0)
                    cleaned = brain.data["stats"].get("clean", 0)
                    brain.data["bond"] = min(45.0, BOND_START + pets * 0.4 + cleaned * 0.5)
            self._brain = brain
            self._brain_save_r = R(self._brain_flush)
            self._ai_history = brain.recent_said(AI_HISTORY)
            if self._cfg.get("brain_enabled", True):
                self._brain_session()
        except Exception as e:
            log(f"[{__id__}] brain init error: {e}")
            self._brain = None

    def _brain_session(self):
        brain = self._brain
        if brain is None or not self._cfg.get("brain_enabled", True):
            return
        try:
            tg_name = self._tg_first_name()
            if tg_name:
                brain.data["tg_name"] = tg_name
            brain.session_start()
            self._brain_dirty()
        except Exception as e:
            log(f"[{__id__}] brain session error: {e}")

    def _brain_dirty(self):
        if self._brain_save_pending or self._handler is None or self._brain_save_r is None or self._unloaded:
            return
        self._brain_save_pending = True
        self._handler.postDelayed(self._brain_save_r, BRAIN_SAVE_DELAY)

    def _brain_flush(self):
        self._brain_save_pending = False
        brain = self._brain
        if brain is None or not brain.dirty:
            return
        try:
            if not brain.save():
                self.set_setting("brain_json", brain.dump())
                brain.dirty = False
        except Exception as e:
            log(f"[{__id__}] brain save error: {e}")

    def _brain_forget(self):
        now = time.monotonic()
        if now > self._forget_armed:
            self._forget_armed = now + 5.0
            self._show_bubble("Тапни «Забыть всё» ещё раз")
            return
        self._forget_armed = 0.0
        brain = self._brain
        if brain is None:
            return
        brain.forget()
        self._ai_history = []
        self._brain_flush()
        try:
            self.set_setting("brain_json", "")
        except Exception:
            pass
        self._show_bubble("Кто я? Где я? Привет!")

    def _mem(self, kind, detail=None, bond=0.0):
        brain = self._brain
        if brain is None or not self._cfg.get("brain_enabled", True):
            return
        try:
            brain.record(kind, detail, bond=bond)
            self._brain_dirty()
        except Exception as e:
            log(f"[{__id__}] brain record error: {e}")

    def _remember_incoming(self, dialog_id, name, keyword):
        brain = self._brain
        if brain is None or not self._cfg.get("brain_enabled", True):
            return
        try:
            brain.chat_msg(dialog_id, name, None, True)
            brain.record("msg_in", name, episode=keyword is None)
            if keyword:
                brain.record(keyword, name)
            self._brain_dirty()
        except Exception as e:
            log(f"[{__id__}] brain incoming error: {e}")

    def _remember_sent(self, ctx, length):
        brain = self._brain
        if brain is None or not self._cfg.get("brain_enabled", True):
            return
        try:
            brain.chat_msg(self._chat_dialog, ctx.get("name"), ctx.get("kind"), False)
            self._mem("essay" if length > 300 else "msg_out", ctx.get("name"), bond=0.15)
        except Exception as e:
            log(f"[{__id__}] brain sent error: {e}")

    def _remember_chat_open(self, fragment, dialog_id, visits):
        brain = self._brain
        if brain is None or not self._cfg.get("brain_enabled", True):
            return visits
        try:
            is_self, name = self._chat_name(fragment)
            label = "Избранное" if is_self else name
            total = brain.chat_visit(dialog_id, label, self._chat_kind(fragment))
            self._mem("chat_open", label)
            return max(visits, total)
        except Exception as e:
            log(f"[{__id__}] brain chat error: {e}")
            return visits

    def _remember_track(self, track):
        brain = self._brain
        if brain is None or not self._cfg.get("brain_enabled", True):
            return
        try:
            brain.track(track)
            self._mem("music", track)
        except Exception as e:
            log(f"[{__id__}] brain track error: {e}")

    def _brain_said(self, text):
        brain = self._brain
        if brain is None or not self._cfg.get("brain_enabled", True):
            return
        try:
            brain.add_said(text)
            self._brain_dirty()
        except Exception as e:
            log(f"[{__id__}] brain said error: {e}")

    def _brain_learn(self, remember):
        brain = self._brain
        if brain is None or not self._cfg.get("brain_enabled", True) or not self._cfg.get("brain_learn", True):
            return
        try:
            changed = False
            for fact in re.split(r"[;\n]+", str(remember or "")):
                fact = fact.strip()
                if not fact:
                    continue
                if brain.add_note(fact):
                    log(f"[{__id__}] brain learned: {fact}")
                    changed = True
            if changed:
                self._brain_dirty()
        except Exception as e:
            log(f"[{__id__}] brain learn error: {e}")

    def _brain_prompt(self):
        brain = self._brain
        if brain is None or not self._cfg.get("brain_enabled", True) or not self._cfg.get("brain_share", True):
            return ""
        try:
            text = brain.prompt_block(self._user_name(), self._cfg.get("brain_about"))
            name = self._pet_name()
            if name != "Луз1к":
                text = text.replace("Память Луз1к", "Память " + name)
            return text
        except Exception as e:
            log(f"[{__id__}] brain prompt error: {e}")
            return ""

    def _brain_static(self, category, name=None):
        brain = self._brain
        if brain is None or not self._cfg.get("brain_enabled", True):
            return None
        try:
            user = self._user_name()
            roll = random.random()
            if category == "hello" and user and roll < 0.7:
                options = [f"Привет, {user}!", f"{user}, это ты!"]
                days = brain.days_together()
                if days >= 3:
                    options.append(f"Мы вместе уже {days} {ru_plural(days, ('день', 'дня', 'дней'))}")
                return random.choice(options)
            if category == "back" and user and roll < 0.7:
                return random.choice([f"{user}, я скучал!", f"С возвращением, {user}!"])
            if category == "pet":
                count = int(brain.data["stats"].get("pet", 0))
                if count >= 25 and roll < 0.25:
                    return f"Ты гладил меня {count} {ru_plural(count, ('раз', 'раза', 'раз'))}. Ещё!"
            if category == "chat_again" and name:
                visits = brain.visits(self._chat_dialog)
                if visits >= 3 and roll < 0.7:
                    return f"{name}: ты тут уже {visits} {ru_plural(visits, ('раз', 'раза', 'раз'))}"
        except Exception as e:
            log(f"[{__id__}] brain static error: {e}")
        return None

    def _ai_ready(self):
        cfg = self._cfg
        primary_ready = bool(cfg.get("ai_key")) or bool(
            int(cfg.get("ai_provider", 0)) == 1 and cfg.get("ai_url")
        )
        return bool(cfg.get("ai_enabled") and (primary_ready or cfg.get("ai2_url")))

    def _ai_primary_ready(self):
        cfg = self._cfg
        if int(cfg.get("ai_provider", 0)) == 1:
            return bool(cfg.get("ai_key") or cfg.get("ai_url"))
        return bool(cfg.get("ai_key"))

    def _ai_providers(self, now):
        cfg = self._cfg
        result = []
        if self._ai_primary_ready() and now >= self._ai_bo[0]:
            result.append(0)
        if cfg.get("ai2_url") and now >= self._ai_bo[1]:
            result.append(1)
        return result

    def _ai_provider_cfg(self, index):
        cfg = self._cfg
        if index == 0:
            return {
                "ai_key": cfg.get("ai_key"),
                "ai_url": cfg.get("ai_url"),
                "ai_model": cfg.get("ai_model"),
                "ai_provider": cfg.get("ai_provider", 0),
                "ai_persona": cfg.get("ai_persona"),
            }
        return {
            "ai_key": cfg.get("ai2_key") or "",
            "ai_url": cfg.get("ai2_url"),
            "ai_model": cfg.get("ai2_model"),
            "ai_provider": 1,
            "ai_persona": cfg.get("ai_persona"),
        }

    def _say(self, category, force=False, name=None, ctx=None):
        if self._bubble is None or (not force and not self._cfg.get("phrases", True)):
            return
        if category == "shot" and not self._cfg.get("sensitive_lines", False):
            self._say_static("respawn", name)
            return
        if not self._ai_ready():
            self._say_static(category, name)
            return
        now = time.monotonic()
        idle = category == "idle"
        if idle:
            gap = AI_CHAT_GAPS[clamp(int(self._cfg.get("ai_chat", 1)), 0, len(AI_CHAT_GAPS) - 1)]
            if gap <= 0 or now < self._ai_idle_next:
                return
        providers = self._ai_providers(now)
        if not providers:
            if self._cfg.get("ai_fallback", True):
                self._say_static(category, name)
            return
        if self._ai_busy or (not force and now < self._ai_next):
            return
        ctx = dict(ctx or {})
        if name and "name" not in ctx:
            ctx["name"] = name
        if not self._cfg.get("ai_text", False):
            ctx.pop("text", None)
        if self._cfg.get("ai_move", True) and "position" not in ctx:
            ctx["position"] = self._position_label()
        self._ai_busy = True
        self._ai_next = now + AI_COOLDOWN
        if idle:
            self._ai_idle_next = now + gap
        self._say_gen += 1
        gen = self._say_gen
        chain = [(index, self._ai_provider_cfg(index)) for index in providers]
        history = list(self._ai_history)
        memory = self._brain_prompt()
        try:
            threading.Thread(
                target=self._ai_worker,
                args=(category, name, ctx, gen, chain, history, memory),
                daemon=True,
            ).start()
        except Exception as e:
            self._ai_busy = False
            log(f"[{__id__}] ai thread error: {e}")
            self._say_static(category, name)

    def _ai_test(self):
        self._ai_bo = [0.0, 0.0]
        self._ai_next = 0.0
        self._ai_idle_next = 0.0
        self._ai_err_next = 0.0
        if self._bubble is None:
            self._start(greet=False)
        if not self._ai_ready():
            self._show_bubble("Включи ИИ и вставь API-ключ")
            return
        self._say("hello", force=True)

    def _ai_worker(self, category, name, ctx, gen, chain, history, memory=""):
        text = None
        mood = None
        action = None
        remember = None
        err = None
        try:
            for index, cfg in chain:
                try:
                    text, mood, action, remember = self._ai_call(cfg, category, ctx, history, memory)
                    if text or action:
                        break
                except AiHttpError as e:
                    log(f"[{__id__}] ai[{index}] http {e.code}: {e.body[:300]}")
                    now = time.monotonic()
                    if e.code == 429:
                        self._ai_bo[index] = now + AI_BACKOFF
                        err = "ИИ: лимит запросов, подожду"
                    elif e.code in (400, 401, 403, 404):
                        self._ai_bo[index] = now + AI_BACKOFF * 5
                        err = AI_ERR_TEXT
                    elif e.code >= 500:
                        self._ai_bo[index] = now + 30.0
                except Exception as e:
                    log(f"[{__id__}] ai[{index}] error: {e}")
                    self._ai_bo[index] = time.monotonic() + 20.0
        finally:
            self._ai_busy = False
        if text or action:
            err = None
            if remember:
                self._brain_learn(remember)
        run_on_ui_thread(lambda: self._ai_deliver(text, mood, action, err, category, name, gen))

    def _ai_deliver(self, text, mood, action, err, category, name, gen):
        if self._unloaded or self._bubble is None or gen != self._say_gen:
            return
        if text or action:
            if text:
                self._ai_history.append(text)
                del self._ai_history[:-AI_HISTORY]
                self._brain_said(text)
                self._last_phrase = text
                self._show_bubble(text)
            if self._cfg.get("ai_moods", True):
                self._apply_mood(mood)
            if self._cfg.get("ai_move", True):
                self._apply_action(action)
            return
        now = time.monotonic()
        if err and now >= self._ai_err_next:
            self._ai_err_next = now + AI_ERR_GAP
            self._show_bubble(err)
            return
        if self._cfg.get("ai_fallback", True):
            self._say_static(category, name)

    def _position_label(self):
        bounds = self._bounds_cache
        if bounds is None:
            return None
        min_x, max_x, min_y, max_y = bounds[:4]
        fx = (self._x - min_x) / max(1.0, max_x - min_x)
        fy = (self._y - min_y) / max(1.0, max_y - min_y)
        horizontal = "у левого края" if fx < 0.2 else "у правого края" if fx > 0.8 else "в середине по горизонтали"
        vertical = "вверху" if fy < 0.25 else "внизу" if fy > 0.75 else "посередине по высоте"
        return f"{horizontal}, {vertical}"

    def _apply_action(self, action):
        if action not in ACTIONS or action == "none" or self._pet is None or self._decor is None:
            return
        if self._state not in ("idle", "walk") or self._hop_active or self._touch is not None:
            return
        bounds = self._bounds_cache
        if bounds is None:
            return
        min_x, max_x = bounds[0], bounds[1]
        now = time.monotonic()
        if action in ("walk_left", "walk_right", "go_left_edge", "go_right_edge", "center"):
            if action == "walk_left":
                target = self._x - random.uniform(self._dp(60), self._dp(160))
            elif action == "walk_right":
                target = self._x + random.uniform(self._dp(60), self._dp(160))
            elif action == "go_left_edge":
                target = min_x
            elif action == "go_right_edge":
                target = max_x
            else:
                target = (min_x + max_x) / 2.0
            lo, hi = min_x, max_x
            if self._platform is not None and self._platform_span is not None:
                x0, x1 = self._platform_span
                lo = max(lo, x0 - self._unit * 4)
                hi = min(hi, x1 - self._unit * 14)
            target = clamp(target, lo, hi)
            if abs(target - self._x) < self._dp(12):
                return
            self._walk_target = target
            self._peek_pending = 0
            self._state = "walk"
            self._look = 1 if target > self._x else -1
        elif action in ("peek_left", "peek_right"):
            if self._platform is not None:
                return
            side = -1 if action == "peek_left" else 1
            self._walk_target = min_x if side < 0 else max_x
            self._peek_pending = side
            self._state = "walk"
        elif action == "hop":
            self._hop(self._dp(500))
        elif action == "sleep":
            if self._state != "idle":
                return
            self._state = "sleep"
            self._look = 0
            self._next_z = now + 0.6
        elif action in ("look_left", "look_right"):
            self._look = -1 if action == "look_left" else 1
        self._last_interaction = now
        self._next_action = max(self._next_action, now + random.uniform(3.0, 6.0))
        self._schedule(0)

    def _apply_mood(self, mood):
        if mood not in MOODS or mood == "neutral" or self._pet is None:
            return
        now = time.monotonic()
        if mood == "happy":
            self._set_expr("happy", 2.0)
            self._spawn_particle("spark")
        elif mood == "love":
            self._set_expr("happy", 2.4)
            for _ in range(3):
                self._spawn_particle("heart")
        elif mood == "laugh":
            self._set_expr("happy", 1.8)
            self._hop(self._dp(420))
            self._spawn_particle("spark")
        elif mood == "excited":
            self._set_expr("happy", 1.8)
            self._hop(self._dp(720))
            for _ in range(3):
                self._spawn_particle("spark")
            self._haptic(0)
        elif mood == "surprised":
            self._set_expr("surprised", 1.2)
            self._hop(self._dp(300))
        elif mood == "scared":
            self._set_expr("surprised", 1.8)
            self._squash_until = now + 0.15
            self._look = random.choice((-1, 1))
            self._haptic(1)
        elif mood == "angry":
            self._set_expr("angry", 2.2)
            self._haptic(1)
        elif mood == "sad":
            self._set_expr("sad", 2.8)
        elif mood == "sleepy":
            self._set_expr("sleep", 2.2)
            self._spawn_particle("zzz")
        elif mood == "wave":
            self._wave_until = now + 1.8
        elif mood == "dizzy":
            self._set_expr("dizzy", 2.4)
        elif mood == "music":
            self._set_expr("happy", 2.0)
            for _ in range(3):
                self._spawn_particle("note")
            self._hop(self._dp(300))
        self._schedule(0)

    def _ai_prompt(self, category, ctx):
        situation = SITUATIONS.get(category, str(category))
        if category == "shot" and not self._cfg.get("sensitive_lines", False):
            situation = "Ты проходишь стилизованный перезапуск и снова появляешься на экране."
        lines = [f"Ситуация: {situation}", f"Сейчас {time.strftime('%H:%M')}."]
        for key, label in CTX_LABELS:
            value = ctx.get(key)
            if value is None or value == "":
                continue
            value = " ".join(str(value).split())[:AI_TEXT_MAX]
            lines.append(f"{label}: {value}")
        return "\n".join(lines)

    def _ai_call(self, cfg, category, ctx, history, memory=""):
        prompt = self._ai_prompt(category, ctx)
        if memory:
            prompt = memory + "\n\n" + prompt
        if history:
            prompt += "\nТвои последние реплики (не повторяйся): " + " | ".join(history)
        system = self._ai_system("ai", AI_SYSTEM)
        if cfg.get("ai_persona"):
            system += " Дополнительно к характеру: " + str(cfg["ai_persona"])
        if int(cfg.get("ai_provider") or 0) == 1:
            raw = self._ai_call_openai(cfg, system, prompt)
        else:
            raw = self._ai_call_gemini(cfg, system, prompt)
        return self._parse_ai(raw)

    def _ai_call_gemini(self, cfg, system, prompt, json_mode=True):
        model = str(cfg.get("ai_model") or AI_GEMINI_MODEL).strip()
        if model.startswith("models/"):
            model = model[len("models/"):]
        url = f"{AI_GEMINI_URL}/models/{model}:generateContent"
        headers = {
            "Content-Type": "application/json",
            "x-goog-api-key": str(cfg["ai_key"]),
            "User-Agent": "Mozilla/5.0 (luz1k_pet plugin)",
        }
        config = {
            "maxOutputTokens": 300 if json_mode else 220,
            "temperature": 1.0,
            "thinkingConfig": {"thinkingLevel": "minimal"},
        }
        if json_mode:
            config["responseMimeType"] = "application/json"
        body = {
            "systemInstruction": {"parts": [{"text": system}]},
            "contents": [{"role": "user", "parts": [{"text": prompt}]}],
            "generationConfig": config,
        }
        try:
            data = self._http_json(url, headers, body)
        except AiHttpError as e:
            if e.code == 400 and "thinking" in e.body.lower():
                body["generationConfig"].pop("thinkingConfig", None)
                data = self._http_json(url, headers, body)
            else:
                raise
        parts = data["candidates"][0]["content"]["parts"]
        return "".join(str(part.get("text", "")) for part in parts if not part.get("thought"))

    def _ai_call_openai(self, cfg, system, prompt, json_mode=True):
        base = str(cfg.get("ai_url") or AI_OPENAI_URL).strip().rstrip("/")
        if not base.lower().startswith(("http://", "https://")):
            base = "https://" + base
        url = base if base.endswith("/chat/completions") else base + "/chat/completions"
        headers = {
            "Content-Type": "application/json",
            "User-Agent": "Mozilla/5.0 (luz1k_pet plugin)",
        }
        if cfg.get("ai_key"):
            headers["Authorization"] = "Bearer " + str(cfg["ai_key"])
        body = {
            "model": str(cfg.get("ai_model") or AI_OPENAI_MODEL),
            "messages": [
                {"role": "system", "content": system},
                {"role": "user", "content": prompt},
            ],
            "max_tokens": 170 if json_mode else 220,
            "temperature": 0.95,
        }
        timeout = AI_TIMEOUT_LOCAL if url.lower().startswith("http://") else AI_TIMEOUT
        data = self._http_json(url, headers, body, timeout)
        return data["choices"][0]["message"]["content"]

    def _parse_ai(self, raw):
        raw = str(raw or "").strip()
        say = None
        mood = None
        action = None
        remember = None
        match = re.search(r"\{.*\}", raw, re.S)
        if match:
            try:
                obj = json.loads(match.group(0))
                say = str(obj.get("say") or "")
                mood = str(obj.get("mood") or "").strip().lower()
                action = str(obj.get("action") or "").strip().lower()
                remember = str(obj.get("remember") or "").strip()
            except Exception:
                say = None
        if say is None and '"say"' in raw:
            def grab(key):
                found = re.search(r'"' + key + r'"\s*:\s*"([^"]*)"', raw)
                return found.group(1).strip().lower() if found else None
            found = re.search(r'"say"\s*:\s*"([^"]*)"', raw)
            say = found.group(1) if found else ""
            mood = grab("mood")
            action = grab("action")
            found = re.search(r'"remember"\s*:\s*"([^"]*)"', raw)
            remember = found.group(1).strip() if found else None
        if say is None:
            say = "" if raw.lstrip().startswith(("{", "`")) else raw
        if mood not in MOODS:
            mood = None
        if action not in ACTIONS:
            action = None
        return self._clean_ai_text(say), mood, action, (remember or None)

    def _http_json(self, url, headers, body, timeout=AI_TIMEOUT):
        request = urllib.request.Request(
            url,
            data=json.dumps(body).encode("utf-8"),
            headers=headers,
            method="POST",
        )
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                return json.loads(response.read().decode("utf-8"))
        except urllib.error.HTTPError as e:
            try:
                detail = e.read().decode("utf-8", "ignore")
            except Exception:
                detail = ""
            raise AiHttpError(e.code, detail) from e

    def _clean_ai_text(self, text, limit=AI_MAX_CHARS):
        text = str(text or "").strip()
        if not text:
            return None
        text = text.splitlines()[0].strip()
        text = text.strip("\"'«»“”„ ")
        if len(text) > limit:
            text = text[: limit - 1].rstrip() + "…"
        return text or None

    # ---------- окошко общения (5 тапов по Луз1ку) ----------

    def _chat_text(self):
        return "\n\n".join(self._chat_turns) if self._chat_turns else self._chat_pick("opener", CHAT_OPENER)

    def _chat_append(self, line):
        self._chat_turns.append(line)
        del self._chat_turns[:-40]
        if self._chat_log is not None:
            try:
                self._chat_log.setText("\n\n".join(self._chat_turns))
            except Exception:
                pass
        if self._chat_scroll is not None:
            try:
                self._chat_scroll.post(R(self._chat_bottom))
            except Exception:
                pass

    def _chat_bottom(self):
        try:
            self._chat_scroll.fullScroll(View.FOCUS_DOWN)
        except Exception:
            pass

    def _close_chat(self):
        dialog = self._chat_window
        self._chat_window = None
        self._chat_log = None
        self._chat_scroll = None
        self._chat_edit = None
        self._chat_send_listener = None
        self._chat_typing = False
        if dialog is not None:
            try:
                dialog.dismiss()
            except Exception:
                pass

    def _open_chat(self):
        if self._unloaded or self._pet is None:
            return
        try:
            from android.app import AlertDialog
            self._close_chat()
            context = self._pet.getContext()
            pad = AndroidUtilities.dp(14)
            root = LinearLayout(context)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(pad, pad, pad, pad)

            log_view = TextView(context)
            log_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13.0)
            log_view.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            log_view.setText(self._chat_text())
            scroll = ScrollView(context)
            scroll.addView(log_view, LinearLayout.LayoutParams(-1, -2))
            root.addView(scroll, LinearLayout.LayoutParams(-1, AndroidUtilities.dp(230)))

            row = LinearLayout(context)
            row.setOrientation(LinearLayout.HORIZONTAL)
            edit = EditText(context)
            edit.setHint("Напиши Луз1ку…")
            row.addView(edit, LinearLayout.LayoutParams(0, -2, 1.0))
            send = Button(context)
            send.setText("Отправить")
            row.addView(send, LinearLayout.LayoutParams(-2, -2))
            root.addView(row, LinearLayout.LayoutParams(-1, -2))

            dialog = AlertDialog.Builder(context).setTitle(self._pet_name()).setView(root).create()
            self._chat_window = dialog
            self._chat_log = log_view
            self._chat_scroll = scroll
            self._chat_edit = edit
            self._chat_send_listener = CallbackClickListener(lambda _v=None: self._chat_send())
            send.setOnClickListener(self._chat_send_listener)
            self._chat_append(self._chat_pick("opener", CHAT_OPENER))
            dialog.show()
            self._chat_bottom()
            self._mem("talk", bond=0.2)
        except Exception as e:
            log(f"[{__id__}] chat open error: {e}")
            self._close_chat()

    def _chat_send(self):
        edit = self._chat_edit
        if edit is None or self._chat_busy or self._unloaded:
            return
        try:
            text = str(edit.getText().toString()).strip()
        except Exception:
            text = ""
        if not text:
            return
        try:
            edit.setText("")
        except Exception:
            pass
        self._chat_append("Ты: " + text)
        self._mem("talk", bond=0.15)
        if self._chat_ai_reply(text):
            self._chat_typing = True
            self._chat_append(self._pet_name() + ": …")
        else:
            self._chat_append(self._chat_local_reply(text))

    def _chat_deliver(self, reply):
        self._chat_drop_typing()
        self._chat_append(self._pet_name() + ": " + reply)
        self._show_bubble(reply)

    def _chat_fail(self, user_text):
        self._chat_drop_typing()
        self._chat_append(self._chat_local_reply(user_text))

    def _chat_drop_typing(self):
        self._chat_typing = False
        if self._chat_turns and self._chat_turns[-1].endswith(": …"):
            self._chat_turns.pop()

    def _chat_local_reply(self, text):
        low = text.lower()
        if "?" in text and len(text) < 40:
            return self._chat_pick("question", CHAT_QUESTION)
        for kind, keys, pool in (
            ("hello", ("привет", "здоров", "хай", "ку", "hello", "hi"), CHAT_HELLO),
            ("love", ("люблю", "скуча", "❤", "♥", "love"), CHAT_LOVE),
            ("howru", ("как дела", "как ты", "как сам", "чё как", "что делаешь", "чем занят"), CHAT_HOWRU),
        ):
            for key in keys:
                if key in low:
                    return self._chat_pick(kind, pool)
        return self._chat_pick("generic", CHAT_GENERIC)

    def _chat_ai_reply(self, text):
        if not self._ai_ready():
            return False
        providers = self._ai_providers(time.monotonic())
        if not providers:
            return False
        self._chat_busy = True
        history = " | ".join(self._chat_turns[-CHAT_HISTORY_MAX:])
        chain = [(index, self._ai_provider_cfg(index)) for index in providers]

        def work():
            reply = None
            for index, cfg in chain:
                try:
                    reply = self._ai_chat_call(cfg, text, history)
                    if reply:
                        break
                except Exception as e:
                    log(f"[{__id__}] chat ai[{index}] error: {e}")
            self._chat_busy = False
            if reply:
                run_on_ui_thread(lambda r=reply: self._chat_deliver(r))
            else:
                run_on_ui_thread(lambda t=text: self._chat_fail(t))

        try:
            threading.Thread(target=work, daemon=True).start()
        except Exception as e:
            log(f"[{__id__}] chat ai thread error: {e}")
            self._chat_busy = False
            return False
        return True

    def _ai_chat_call(self, cfg, user_text, history):
        system = self._ai_system("chat", AI_CHAT_SYSTEM)
        if cfg.get("ai_persona"):
            system += " Дополнительно к характеру: " + str(cfg["ai_persona"])
        parts = []
        memory = self._brain_prompt()
        if memory:
            parts.append(memory)
        if history:
            parts.append("Начало разговора: " + history)
        parts.append("Сообщение: " + user_text)
        prompt = "\n\n".join(parts)
        if int(cfg.get("ai_provider") or 0) == 1:
            raw = self._ai_call_openai(cfg, system, prompt, json_mode=False)
        else:
            raw = self._ai_call_gemini(cfg, system, prompt, json_mode=False)
        return self._clean_ai_text(raw, 160)

    def _say_static(self, category, name=None):
        book = self._avatar_phrase_book()
        if book is PHRASES:
            memo = self._brain_static(category, name)
            if memo and memo != self._last_phrase:
                self._last_phrase = memo
                self._show_bubble(memo)
                return
        phrases = list(book.get(category, PHRASES.get(category, [category])))
        if self._cfg.get("sensitive_lines", False):
            extra = book.get("sensitive", {}).get(category)
            if extra is None:
                extra = SENSITIVE_LINES.get(category, ())
            phrases.extend(extra)
        if name is None:
            phrases = [p for p in phrases if "{name}" not in p] or phrases
        options = [p for p in phrases if p != self._last_phrase] or phrases
        text = random.choice(options)
        if "{name}" in text:
            text = text.replace("{name}", name or "")
        self._last_phrase = text
        self._show_bubble(text)

    def _show_bubble(self, text):
        if self._bubble is None:
            return
        now = time.monotonic()
        try:
            bg = GradientDrawable()
            bg.setCornerRadius(float(AndroidUtilities.dp(12)))
            bg.setColor(Theme.getColor(Theme.key_windowBackgroundWhite))
            bg.setStroke(max(1, AndroidUtilities.dp(1)), Theme.getColor(Theme.key_divider))
            self._bubble.setBackground(bg)
            self._bubble.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            try:
                self._bubble.setElevation(float(AndroidUtilities.dp(2)))
            except Exception:
                pass
            self._bubble.animate().cancel()
            self._bubble.setText(text)
            self._bubble.setAlpha(0.0)
            self._bubble.setVisibility(View.VISIBLE)
            self._bubble_gen += 1
            self._bubble_visible = True
            self._bubble_fade_in = True
            self._bubble_until = now + 2.0 + len(text) * 0.05
        except Exception as e:
            log(f"[{__id__}] bubble error: {e}")

    def _hide_bubble(self):
        if self._bubble is None or not self._bubble_visible:
            return
        self._bubble_visible = False
        self._bubble_fade_in = False
        self._bubble_gen += 1
        gen = self._bubble_gen
        bubble = self._bubble

        def _gone():
            if gen == self._bubble_gen and bubble is not None:
                bubble.setVisibility(View.GONE)

        anim = bubble.animate().alpha(0.0).setDuration(180)
        anim.withEndAction(R(_gone))
        anim.start()

    def _update_bubble(self, now, width, min_y):
        if self._bubble is None or not self._bubble_visible:
            return
        if now >= self._bubble_until:
            self._hide_bubble()
            return
        bw = self._bubble.getWidth()
        bh = self._bubble.getHeight()
        if bw <= 0:
            return
        margin = self._dp(4)
        bx = clamp(self._x + self._w / 2.0 - bw / 2.0, margin, width - bw - margin)
        by = self._y + self._hop_off + self._unit - bh - margin
        if by < min_y:
            by = self._y + self._hop_off + self._h + margin
        self._bubble.setTranslationX(float(bx))
        self._bubble.setTranslationY(float(by))
        if self._bubble_fade_in:
            self._bubble_fade_in = False
            self._bubble.animate().alpha(1.0).setDuration(150).start()

    def _input_top(self):
        now = time.monotonic()
        if self._input_cache is not None and now - self._input_time < 0.5:
            return self._input_cache
        top = None
        try:
            fragment = get_last_fragment()
            if fragment is not None and isinstance(fragment, ChatActivity):
                enter = fragment.getChatActivityEnterView()
                rect = self._platform_rect(enter, "input")
                if rect is not None:
                    top = rect[2]
        except Exception:
            top = None
        self._input_cache = top
        self._input_time = now
        return top

    def _trigger_shotgun(self, now=None):
        now = now if now is not None else time.monotonic()
        if self._shot is not None or self._pet is None:
            return
        self._touch = None
        self._vx = 0.0
        self._vy = 0.0
        self._slide_v = 0.0
        self._hop_active = False
        self._hop_off = 0.0
        self._hop_vy = 0.0
        self._platform = None
        self._platforms = []
        self._peek_side = 0
        self._peek_pending = 0
        self._afk_kind = None
        self._afk_frame = None
        self._state = "shot"
        self._shot = {"idx": 0, "until": now + SHOT_SEQ[0][1]}
        self._afk_frame = SHOT_SEQ[0][0]
        self._shot_gone_fx = False
        self._set_expr("surprised", 0.8)
        self._haptic(1)
        self._mem("shot")
        self._say("shot", force=True)
        self._schedule(0)

    def _step_shot(self, now):
        shot = self._shot
        if shot is None:
            return
        if now >= shot["until"]:
            shot["idx"] += 1
            if shot["idx"] >= len(SHOT_SEQ):
                self._shot = None
                self._afk_frame = None
                self._respawn(now)
                return
            shot["until"] = now + SHOT_SEQ[shot["idx"]][1]
        self._afk_frame = SHOT_SEQ[shot["idx"]][0]
        if self._avatar_mode() and self._afk_frame == "shot_gone" and not self._shot_gone_fx:
            self._shot_gone_fx = True
            for _ in range(3):
                self._spawn_particle(
                    "blood",
                    (self._x + self._w * random.uniform(0.3, 0.7), self._y + self._h * 0.55),
                )

    def _respawn(self, now):
        self._state = "idle"
        self._afk_frame = None
        self._afk_kind = None
        if self._decor is not None and self._decor.getWidth() > 0:
            min_x, max_x, min_y, max_y = self._bounds(now)[:4]
            self._x = (min_x + max_x) / 2.0
            self._y = (min_y + max_y) / 2.0
            self._pos_ready = True
            self._save_position()
        self._last_interaction = now
        self._next_action = now + random.uniform(2.0, 5.0)
        self._hop(self._dp(420))
        self._say("respawn")
        self._schedule(0)

    def _afk_phrases(self, kind):
        book = self._avatar_phrase_book()
        override = book.get("afk", {}).get(kind) if book is not PHRASES else None
        phrases = list(override) if override else list(AFK_ANIMS[kind]["phrases"])
        if self._cfg.get("sensitive_lines", False):
            extra = book.get("sensitive", {}).get(kind) if book is not PHRASES else None
            phrases.extend(extra if extra is not None else SENSITIVE_LINES.get(kind, ()))
        return phrases

    def _step_afk(self, now):
        psi = self._temper_idx() >= 4
        if psi and self._afk_kind is not None and now >= self._afk_next:
            # ПСИХ: перескакивает между сценами без остановки
            if random.random() < 0.6:
                kinds = [
                    k for k in AFK_ANIMS
                    if k != self._afk_kind and not (k == "sick" and self._vomit_stain is not None)
                ]
                self._afk_kind = random.choice(kinds)
                self._afk_idx = 0
                self._afk_vomit_done = False
                self._afk_next = now + AFK_ANIMS[self._afk_kind]["durations"][0]
                if self._cfg.get("phrases", True) and random.random() < 0.5:
                    self._show_bubble(random.choice(self._afk_phrases(self._afk_kind)))
        if self._afk_kind is None:
            kinds = [k for k in AFK_ANIMS if not (k == "sick" and self._vomit_stain is not None)]
            self._afk_kind = random.choice(kinds)
            self._afk_idx = 0
            self._afk_vomit_done = False
            self._afk_next = now + AFK_ANIMS[self._afk_kind]["durations"][0]
            if self._cfg.get("phrases", True) and random.random() < 0.5:
                self._show_bubble(random.choice(self._afk_phrases(self._afk_kind)))
        anim = AFK_ANIMS[self._afk_kind]
        if now >= self._afk_next:
            self._afk_idx = (self._afk_idx + 1) % len(anim["frames"])
            self._afk_next = now + anim["durations"][self._afk_idx]
        self._afk_frame = anim["frames"][self._afk_idx]
        if self._avatar_mode():
            self._avatar_afk_fx(now)
        if self._afk_kind == "sick":
            if self._afk_idx == 2 and not self._afk_vomit_done:
                self._leave_vomit()
                self._afk_vomit_done = True
            elif self._afk_idx == 3:
                self._afk_kind = None
                self._afk_frame = None
                self._forced_afk = False
                self._last_interaction = now

    def _avatar_afk_fx(self, now):
        """Пар при затяжке и капли крови для своей картинки-модельки."""
        kind = self._afk_kind
        if kind is None or now < self._next_afk_fx:
            return
        h4te = self._avatar_key() == "luz1k_avatar0_h4teboy.png"
        mouth_y = 0.47 if h4te else 0.32
        if kind == "pod" and self._afk_idx >= 1:
            self._next_afk_fx = now + 0.55
            self._spawn_particle(
                "vapor",
                (self._x + self._w * (0.45 if h4te else 0.6),
                 self._y + self._hop_off + self._h * mouth_y),
            )
        elif kind == "beer" and self._afk_idx == 2:
            self._next_afk_fx = now + 0.9
            self._spawn_particle(
                "beer",
                (self._x + self._w * 0.5, self._y + self._hop_off + self._h * mouth_y),
            )
        elif kind == "veins" and self._afk_idx >= 1:
            self._next_afk_fx = now + 0.75
            self._spawn_particle(
                "blood",
                (self._x + self._w * (0.22 if h4te else 0.25),
                 self._y + self._hop_off + self._h * (0.79 if h4te else 0.55)),
            )
