def _prop_cells(cells, chars=None):
    return [(x, y, ch) for (x, y, ch) in cells if chars is None or ch in chars]


# Своя картинка-«моделька»: эти пропсы рисуются поверх неё в сценах,
# вместо подмены пиксельным спрайтом. Лицо и тело не рисуем — только предметы.
AVATAR_PROPS = {
    "pod_a": _prop_cells(_POD_CELLS),
    "pod_b": _prop_cells(_POD_CELLS) + [(15, 16, "O"), (15, 11, "U")],
    "pod_c": _prop_cells(_POD_CELLS) + [(x, y, "V") for x, y in POD_CLOUD],
    "beer_a": _prop_cells(_BEER_HOLD),
    "beer_b": _prop_cells(_BEER_DRINK),
    "beer_c": _prop_cells(_BEER_DONE),
    "vein_a": _prop_cells(_VEIN_AIM, ("M", "D")),
    "vein_b": _prop_cells(_VEIN_CUT, ("M", "R", "Q")),
    "vein_c": _prop_cells(_VEIN_DRIP, ("M", "R", "Q")),
    "sick_a": _prop_cells(_SICK_A, ("R", "Q")),
    "sick_b": _prop_cells(_SICK_B, ("R", "Q")),
    "sick_c": _prop_cells(_SICK_C, ("R", "Q")),
    "shot_aim": [
        (14, 7, "M"), (15, 7, "M"), (16, 7, "M"), (17, 7, "M"),
        (17, 6, "D"), (17, 8, "D"), (16, 8, "D"),
    ],
    "shot_flash": _flash_cells(),
    "shot_gone": _cells_of(_shotgun_gone()),
}

