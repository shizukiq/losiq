class PetTouchListener(dynamic_proxy(View.OnTouchListener)):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def onTouch(self, view, event):
        try:
            return bool(self.plugin._on_touch(event))
        except Exception as e:
            log(f"[{__id__}] touch error: {e}")
            return False


class ShakeListener(dynamic_proxy(SensorEventListener)):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def onSensorChanged(self, event):
        try:
            self.plugin._on_accel(event.values)
        except Exception:
            pass

    def onAccuracyChanged(self, sensor, accuracy):
        pass


class Luz1kPetPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._handler = None
        self._tick_r = None
        self._running = False
        self._decor = None
        self._pet = None
        self._bubble = None
        self._touch_listener = None

        self._x = 200.0
        self._y = 400.0
        self._hop_y = 0.0
        self._hop_vy = 0.0
        self._w = 1
        self._h = 1
        self._unit = 1

        self._touch = None
        self._last_tap = 0.0
        self._tap_chain = []
        self._blink_until = 0.0
        self._next_blink = 0.0
        self._rage_until = 0.0
        self._bubble_until = 0.0
        self._frame_cache = {}
        self._last_key = None

        self._last_activity = 0.0
        self._afk_kind = None
        self._afk_idx = 0
        self._afk_next = 0.0
        self._hanging = False
        self._shot = None

        self._fling_vx = 0.0
        self._fling_vy = 0.0
        self._last_shake = 0.0
        self._last_screen = (0, 0)

        self._sensor_sm = None
        self._sensor_listener = None

    def on_plugin_load(self):
        self._handler = Handler(Looper.getMainLooper())
        self._tick_r = R(self._tick)
        self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.DRAWER_MENU,
                text="ЛУЗ1К",
                on_click=lambda _=None: self._toggle_show(),
                item_id="luz1k_toggle",
                icon="msg_emoji_cat",
            )
        )
        self.add_on_send_message_hook()
        run_on_ui_thread(self._start)

    def on_plugin_unload(self):
        self._running = False
        if self._handler and self._tick_r:
            self._handler.removeCallbacks(self._tick_r)
        self._unregister_sensors()
        run_on_ui_thread(self._detach_views)

    def on_app_event(self, event_type):
        if event_type == AppEvent.PAUSE:
            self._running = False
            if self._handler and self._tick_r:
                self._handler.removeCallbacks(self._tick_r)
        elif event_type == AppEvent.RESUME:
            run_on_ui_thread(self._start)

    def on_send_message_hook(self, account, params):
        try:
            msg = str(getattr(params, "message", "") or "")
            if len(msg) > 200 and self._running:
                run_on_ui_thread(self._on_long_msg)
        except Exception:
            pass
        return HookResult()

    def create_settings(self) -> List[Any]:
        return [
            Header(text="ЛУЗ1К — Настройки"),
            Switch(
                key="show",
                text="Показывать Луз1ка",
                default=True,
                icon="msg_emoji_cat",
                on_change=lambda v: run_on_ui_thread(self._start if v else self._detach_views),
            ),
            Selector(
                key="size",
                text="Размер",
                default=1,
                items=SIZE_ITEMS,
                icon="msg_photo_settings",
                on_change=lambda _: run_on_ui_thread(self._rebuild),
            ),
            Selector(
                key="style",
                text="Палитра скетча",
                default=0,
                items=STYLE_ITEMS,
                icon="msg_colors",
                on_change=lambda _: run_on_ui_thread(self._rebuild),
            ),
            Switch(
                key="sketch_boil",
                text="Живой скетч-контур",
                default=True,
                subtext="Лёгкое дрожание нарисованного персонажа",
                icon="msg_photo_rotate",
            ),
            Divider(),
            Text(
                text="Призвать в центр экрана",
                icon="msg_retry",
                accent=True,
                on_click=lambda _=None: run_on_ui_thread(self._recenter),
            ),
        ]

    def _toggle_show(self):
        cur = bool(self.get_setting("show", True))
        self.set_setting("show", not cur)
        run_on_ui_thread(self._start if not cur else self._detach_views)

    def _start(self):
        if not bool(self.get_setting("show", True)):
            return
        self._ensure_attached()
        if self._pet is None:
            run_on_ui_thread(self._start, 500)
            return
        self._running = True
        self._last_activity = time.monotonic()
        self._schedule(16)

    def _schedule(self, delay_ms):
        if self._handler and self._tick_r:
            self._handler.removeCallbacks(self._tick_r)
            self._handler.postDelayed(self._tick_r, int(delay_ms))

    def _ensure_attached(self):
        act = getattr(LaunchActivity, "instance", None)
        if act is None:
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
        if act is None or act.isFinishing():
            return
        decor = act.getWindow().getDecorView()
        if self._pet and self._decor and self._pet.getParent() and self._decor.equals(decor):
            return
        self._detach_views()
        self._decor = decor
        self._build_views(act)

    def _build_views(self, context):
        self._update_metrics()
        pet = ImageView(context)
        pet.setScaleType(ImageView.ScaleType.FIT_XY)
        self._touch_listener = PetTouchListener(self)
        pet.setOnTouchListener(self._touch_listener)
        self._decor.addView(pet, FrameLayout.LayoutParams(self._w, self._h))
        self._pet = pet

        bubble = TextView(context)
        bubble.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12.5)
        bubble.setPadding(
            AndroidUtilities.dp(10),
            AndroidUtilities.dp(5),
            AndroidUtilities.dp(10),
            AndroidUtilities.dp(5),
        )
        try:
            bubble.setTypeface(AndroidUtilities.bold())
        except Exception:
            pass
        bubble.setVisibility(View.GONE)
        self._decor.addView(bubble, FrameLayout.LayoutParams(-2, -2))
        self._bubble = bubble

        self._x = float(self.get_setting("pos_x", 220) or 220)
        self._y = float(self.get_setting("pos_y", 420) or 420)
        self._x = clamp(self._x, 0.0, float(max(0, self._decor.getWidth() - self._w)))
        self._y = clamp(self._y, 0.0, float(max(0, self._bottom_limit() - self._h)))
        self._last_key = None
        self._last_screen = (self._decor.getWidth(), self._decor.getHeight())
        self._register_sensors(context)

    def _detach_views(self):
        for v in (self._bubble, self._pet):
            if v and v.getParent():
                v.getParent().removeView(v)
        self._pet = None
        self._bubble = None
        self._decor = None

    def _update_metrics(self):
        idx = clamp(int(self.get_setting("size", 1) or 0), 0, len(SIZE_DP) - 1)
        self._unit = max(2, AndroidUtilities.dp(SIZE_DP[idx]))
        self._w = GRID_W * self._unit
        self._h = GRID_H * self._unit
        self._frame_cache.clear()

    def _rebuild(self):
        self._update_metrics()
        if self._pet:
            lp = self._pet.getLayoutParams()
            lp.width = self._w
            lp.height = self._h
            self._pet.setLayoutParams(lp)
            self._last_key = None

    def _bottom_limit(self):
        # Нижняя граница зоны, где Луз1ку можно быть: над клавиатурой и навбаром
        d = self._decor
        if d is None:
            return 0
        try:
            r = Rect()
            d.getWindowVisibleDisplayFrame(r)
            if r.bottom > 0:
                return min(d.getHeight(), r.bottom)
        except Exception:
            pass
        return d.getHeight()

    def _render(self, name, blink=False, rage=False):
        style_idx = clamp(int(self.get_setting("style", 0) or 0), 0, len(PALETTES) - 1)
        key = (name, style_idx, blink, rage)
        if key in self._frame_cache:
            return self._frame_cache[key]

        pal = dict(PALETTES[style_idx])
        s = self._unit
        bmp = Bitmap.createBitmap(self._w, self._h, Bitmap.Config.ARGB_8888)
        canvas = Canvas(bmp)
        paint = Paint()
        matrix = FRAME_MATRIX[name]

        for y, row in enumerate(matrix):
            for x, ch in enumerate(row):
                if ch == ".":
                    continue
                if blink and ch == "E":
                    col = pal["W"]
                elif rage and ch in ("E", "P"):
                    col = 0xFFFF1E1E  # Бешеные красные зрачки
                else:
                    col = pal.get(ch, 0xFF000000)
                paint.setColor(jint(as_java_color(col)))
                canvas.drawRect(float(x * s), float(y * s), float((x + 1) * s), float((y + 1) * s), paint)

        self._frame_cache[key] = bmp
        return bmp

    def _tick(self):
        if not self._running:
            return
        now = time.monotonic()
        self._ensure_attached()
        if self._pet is None or self._decor is None:
            self._schedule(500)
            return

        w = self._decor.getWidth()
        hgt = self._decor.getHeight()
        if (w, hgt) != self._last_screen:
            # Поворот экрана / смена декора: клампим и подпрыгиваем
            self._last_screen = (w, hgt)
            self._x = clamp(self._x, 0.0, float(max(0, w - self._w)))
            self._y = clamp(self._y, 0.0, float(max(0, self._bottom_limit() - self._h)))
            self._hop_vy = -float(AndroidUtilities.dp(300))

        dt = 0.016
        bottom = float(self._bottom_limit())

        # Физика прыжка
        if self._hop_y < 0.0 or self._hop_vy != 0.0:
            self._hop_y += self._hop_vy * dt
            self._hop_vy += AndroidUtilities.dp(2000) * dt
            if self._hop_y >= 0.0:
                self._hop_y = 0.0
                self._hop_vy = 0.0

        # Физика полёта после тряски: баллистика + отскоки от краёв
        if self._fling_vx != 0.0 or self._fling_vy != 0.0:
            self._x += self._fling_vx * dt
            self._y += self._fling_vy * dt
            self._fling_vy += AndroidUtilities.dp(2600) * dt
            max_x = max(0, w - self._w)
            max_y = max(0.0, bottom - self._h)
            if self._x < 0.0:
                self._x = 0.0
                self._fling_vx = -self._fling_vx * 0.55
            if self._x > max_x:
                self._x = float(max_x)
                self._fling_vx = -self._fling_vx * 0.55
            if self._y < 0.0:
                self._y = 0.0
                self._fling_vy = -self._fling_vy * 0.55
            if self._y > max_y:
                self._y = max_y
                self._fling_vy = -self._fling_vy * 0.55
            if (
                abs(self._fling_vx) < AndroidUtilities.dp(80)
                and abs(self._fling_vy) < AndroidUtilities.dp(80)
                and self._y >= max_y - 1.0
            ):
                self._fling_vx = 0.0
                self._fling_vy = 0.0

        # Машина состояний: дробовик > висилица > афк-анимации > норма
        idle_for = now - self._last_activity
        frame_name = "idle"
        jitter_x = 0.0
        rot = 0.0
        blink = False
        rage = False

        if self._shot is not None:
            if now >= self._shot["until"]:
                self._shot["idx"] += 1
                if self._shot["idx"] >= len(self._shot["seq"]):
                    self._shot = None
                    self._respawn()
                else:
                    self._shot["until"] = now + self._shot["seq"][self._shot["idx"]][1]
            if self._shot is not None:
                frame_name = self._shot["seq"][self._shot["idx"]][0]
            else:
                frame_name = "idle"
        elif self._hanging:
            frame_name = "hang"
            rot = math.sin(now * 1.6) * 7.0  # покачивание на верёвке
        elif idle_for >= HANG_AFTER:
            self._hanging = True
            self._afk_kind = None
            self._say("*уснул на висилице*")
        elif idle_for >= AFK_AFTER:
            if self._afk_kind is None:
                self._afk_kind = random.choice(list(AFK_ANIMS.keys()))
                self._afk_idx = 0
                self._afk_next = now + AFK_ANIMS[self._afk_kind]["durations"][0]
                self._say(random.choice(AFK_ANIMS[self._afk_kind]["phrases"]))
            anim = AFK_ANIMS[self._afk_kind]
            if now >= self._afk_next:
                self._afk_idx = (self._afk_idx + 1) % len(anim["frames"])
                self._afk_next = now + anim["durations"][self._afk_idx]
            frame_name = anim["frames"][self._afk_idx]
        else:
            self._afk_kind = None

        if frame_name == "idle":
            # Таймер моргания
            if now >= self._next_blink:
                self._blink_until = now + 0.14
                self._next_blink = now + random.uniform(2.2, 5.0)
            blink = now < self._blink_until
            rage = now < self._rage_until
            if rage:
                jitter_x = random.uniform(-AndroidUtilities.dp(2.5), AndroidUtilities.dp(2.5))
                rot = random.uniform(-6.0, 6.0)
            elif bool(self.get_setting("sketch_boil", True)) and int(now * 4) % 2 == 0:
                rot = 1.2 if int(now * 2) % 2 == 0 else -1.2

        state_key = (frame_name, blink, rage)
        if state_key != self._last_key:
            self._last_key = state_key
            self._pet.setImageBitmap(self._render(frame_name, blink, rage))

        self._pet.setTranslationX(float(self._x + jitter_x))
        self._pet.setTranslationY(float(self._y + self._hop_y))
        self._pet.setRotation(float(rot))

        # Позиционирование текстового облачка
        if self._bubble and self._bubble.getVisibility() == View.VISIBLE:
            if now >= self._bubble_until:
                self._bubble.setVisibility(View.GONE)
            else:
                bw = self._bubble.getWidth()
                bh = self._bubble.getHeight()
                bx = clamp(self._x + self._w / 2.0 - bw / 2.0, 8.0, float(max(8, w - bw - 8)))
                by = self._y + self._hop_y - bh - AndroidUtilities.dp(6)
                if by < AndroidUtilities.statusBarHeight:
                    by = self._y + self._hop_y + self._h + AndroidUtilities.dp(6)
                by = min(by, max(0.0, bottom - bh))
                self._bubble.setTranslationX(float(bx))
                self._bubble.setTranslationY(float(by))

        active = (
            self._hop_vy != 0.0
            or self._touch is not None
            or self._fling_vx != 0.0
            or self._fling_vy != 0.0
            or rage
            or self._shot is not None
            or self._hanging
            or self._afk_kind is not None
        )
        self._schedule(16 if active else 90)

    def _on_touch(self, event):
        action = event.getActionMasked()
        rx, ry = float(event.getRawX()), float(event.getRawY())
        now = time.monotonic()

        if self._shot is not None:
            return True

        if action == MotionEvent.ACTION_DOWN:
            self._fling_vx = 0.0
            self._fling_vy = 0.0
            self._wake(now, say=False)
            self._touch = {"x0": rx, "y0": ry, "ox": rx - self._x, "oy": ry - self._y, "drag": False}
            self._schedule(0)
            return True

        if not self._touch:
            return False

        if action == MotionEvent.ACTION_MOVE:
            if abs(rx - self._touch["x0"]) > 10 or abs(ry - self._touch["y0"]) > 10:
                if not self._touch["drag"]:
                    self._touch["drag"] = True
                    if random.random() < 0.35:
                        self._say(random.choice(PHRASES["drag"]))
            if self._touch["drag"] and self._decor:
                max_x = max(0, self._decor.getWidth() - self._w)
                max_y = max(0, self._bottom_limit() - self._h)
                self._x = clamp(rx - self._touch["ox"], 0.0, float(max_x))
                self._y = clamp(ry - self._touch["oy"], 0.0, float(max_y))
                # Прёт интерфейс внизу -> дробовик вместо фразы
                zone_y = self._bottom_limit() - AndroidUtilities.dp(SHOT_ZONE_DP)
                if self._y + self._h * 0.5 > zone_y:
                    self._trigger_shotgun()
            return True

        if action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
            was_drag = self._touch["drag"]
            self._touch = None
            if was_drag:
                self.set_setting("pos_x", int(self._x))
                self.set_setting("pos_y", int(self._y))
            else:
                self._handle_tap(now)
            self._schedule(0)
            return True
        return True

    def _wake(self, now=None, say=True):
        now = now if now is not None else time.monotonic()
        was_sleeping = self._hanging or self._afk_kind is not None
        self._last_activity = now
        self._hanging = False
        self._afk_kind = None
        if was_sleeping and say:
            self._say(random.choice(PHRASES["wake"]))
            self._hop_vy = -float(AndroidUtilities.dp(340))

    def _trigger_shotgun(self):
        self._touch = None
        self._hanging = False
        self._afk_kind = None
        self._fling_vx = 0.0
        self._fling_vy = 0.0
        self._shot = {"seq": SHOT_SEQ, "idx": 0, "until": time.monotonic() + SHOT_SEQ[0][1]}
        self._say(random.choice(PHRASES["shot"]), rage=True)
        try:
            self._pet.performHapticFeedback(1)
        except Exception:
            pass
        self._schedule(0)

    def _respawn(self):
        if self._decor and self._decor.getWidth() > 0:
            self._x = (self._decor.getWidth() - self._w) / 2.0
            self._y = clamp(
                (self._decor.getHeight() - self._h) / 2.0,
                0.0,
                float(max(0, self._bottom_limit() - self._h)),
            )
            self.set_setting("pos_x", int(self._x))
            self.set_setting("pos_y", int(self._y))
        self._last_activity = time.monotonic()
        self._hop_vy = -float(AndroidUtilities.dp(420))
        self._say(random.choice(PHRASES["respawn"]))
        self._schedule(0)

    def _handle_tap(self, now: float):
        self._tap_chain = [t for t in self._tap_chain if now - t < 2.2] + [now]

        # Двойной тап или спам тапами -> RAGE
        if len(self._tap_chain) >= 5 or (now - self._last_tap < 0.32):
            self._last_tap = 0.0
            self._tap_chain.clear()
            self._rage_until = now + 2.2
            self._hop_vy = -float(AndroidUtilities.dp(520))
            self._say(random.choice(PHRASES["rage"]), rage=True)
            try:
                self._pet.performHapticFeedback(1)
            except Exception:
                pass
            return

        self._last_tap = now
        self._hop_vy = -float(AndroidUtilities.dp(340))
        self._say(random.choice(PHRASES["tap"]))
        try:
            self._pet.performHapticFeedback(3)
        except Exception:
            pass

    def _on_long_msg(self):
        self._hop_vy = -float(AndroidUtilities.dp(380))
        self._say(random.choice(PHRASES["essay"]))
        self._schedule(0)

    def _on_accel(self, values):
        try:
            ax, ay, az = float(values[0]), float(values[1]), float(values[2])
        except Exception:
            return
        mag = math.sqrt(ax * ax + ay * ay + az * az)
        now = time.monotonic()
        if mag < 21.0 or not self._running or self._shot is not None:
            return
        if now - self._last_shake < 1.4:
            return
        self._last_shake = now
        self._wake(now, say=False)
        self._fling_vx = random.choice((-1.0, 1.0)) * float(
            AndroidUtilities.dp(random.uniform(1800, 2800))
        )
        self._fling_vy = -float(AndroidUtilities.dp(random.uniform(900, 1700)))
        self._say(random.choice(PHRASES["shake"]), rage=True)
        self._schedule(0)

    def _register_sensors(self, context):
        if self._sensor_sm is not None:
            return
        try:
            sm = context.getSystemService(Context.SENSOR_SERVICE)
            if sm is None:
                return
            self._sensor_listener = ShakeListener(self)
            sm.registerListener(
                self._sensor_listener,
                sm.getDefaultSensor(SensorManager.TYPE_ACCELEROMETER),
                SensorManager.SENSOR_DELAY_GAME,
            )
            self._sensor_sm = sm
        except Exception as e:
            log(f"[{__id__}] accelerometer unavailable: {e}")
            self._sensor_sm = None
            self._sensor_listener = None

    def _unregister_sensors(self):
        if self._sensor_sm is not None and self._sensor_listener is not None:
            try:
                self._sensor_sm.unregisterListener(self._sensor_listener)
            except Exception:
                pass
        self._sensor_sm = None
        self._sensor_listener = None

    def _say(self, text: str, rage: bool = False):
        if not self._bubble:
            return
        bg = GradientDrawable()
        bg.setCornerRadius(float(AndroidUtilities.dp(8)))
        bg.setColor(jint(as_java_color(0xFF141414)))
        stroke_col = 0xFFFF2A2A if rage else 0xFFFAFAFA
        bg.setStroke(max(2, AndroidUtilities.dp(1.5)), jint(as_java_color(stroke_col)))
        self._bubble.setBackground(bg)
        self._bubble.setTextColor(jint(as_java_color(0xFFFF4D4D if rage else 0xFFFAFAFA)))
        self._bubble.setText(text)
        self._bubble.setVisibility(View.VISIBLE)
        self._bubble_until = time.monotonic() + 2.6

    def _recenter(self):
        if self._decor and self._decor.getWidth() > 0:
            self._x = (self._decor.getWidth() - self._w) / 2.0
            self._y = clamp(
                (self._decor.getHeight() - self._h) / 2.0,
                0.0,
                float(max(0, self._bottom_limit() - self._h)),
            )
            self.set_setting("pos_x", int(self._x))
            self.set_setting("pos_y", int(self._y))
            self._last_activity = time.monotonic()
            self._hanging = False
            self._afk_kind = None
            self._hop_vy = -float(AndroidUtilities.dp(420))
            self._say("ЛУЗ1К В ЗДАНИИ!")
            self._schedule(0)
