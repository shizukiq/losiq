__sdk_version__ = ">=1.4.5.7"
__category__ = ["fun", "integrations"]

# Пиксель-арт матрица Луз1ка (18x28) по скетчу:
# K - контур, W - белый, G - серые митенки/пояс, D - тёмные полоски,
# P - розовый нос, R - кровь, E - зрачки, S - пирсинг
SPRITE_IDLE = (
    "..KK...K.K.K...KK.",
    ".KWWK..KKKKK..KWWK",
    ".KWWK...KKK...KWSK",
