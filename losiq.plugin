# Верёвка, за которую висит Луз1к во сне: рисуется ПОД картинкой.
ROPE_CELLS = [(x, y, ch) for (x, y, ch) in _cells_of(SPRITE_HANG) if ch == "N"]

SIZE_ITEMS = ["Маленький", "Средний", "Большой"]
SIZE_DP = [1.7, 2.2, 2.8]

