GRID_W = len(SPRITE_IDLE[0])
GRID_H = len(SPRITE_IDLE)

# геометрия лица для оверлеев (клетки сетки)
EYE_L = 6
EYE_R = 12
EYE_TOP = 6
EYE_BOT = 7


def _clone(base):
    return [list(row) for row in base]


def _to_tuple(grid):
    return tuple("".join(row) for row in grid)


def _set(grid, cells):
    for x, y, ch in cells:
        if 0 <= y < len(grid) and 0 <= x < len(grid[0]):
            grid[y][x] = ch
    return grid


def _blank():
    return [["."] * GRID_W for _ in range(GRID_H)]


def _tint(base, ch_to):
    return tuple("".join((ch_to if c != "." else ".") for c in row) for row in base)


def _cells_of(grid):
    return [
        (x, y, ch)
        for y, row in enumerate(grid)
        for x, ch in enumerate(row)
        if ch != "."
    ]


def _flash_cells():
    """Клетки одной вспышки выстрела — без тела, чтобы лечь поверх картинки."""
    cells = []
    for y in range(2, 12):
        for x in range(3, 15):
            dx = x - 9
            dy = (y - 6.5) * 1.4
            d2 = dx * dx + dy * dy
            if d2 <= 30:
                if d2 < 4:
                    cells.append((x, y, "K"))
                elif (x + y) % 3 == 0:
                    cells.append((x, y, "O"))
                else:
                    cells.append((x, y, "F"))
    return cells


def _shotgun_flash():
    g = _clone(SPRITE_IDLE)
    for y in range(2, 12):
        for x in range(2, 16):
            g[y][x] = "."
    for y in range(2, 12):
        for x in range(3, 15):
            dx = x - 9
            dy = (y - 6.5) * 1.4
            d2 = dx * dx + dy * dy
            if d2 <= 30:
                if d2 < 4:
                    g[y][x] = "K"
                elif (x + y) % 3 == 0:
                    g[y][x] = "O"
                else:
                    g[y][x] = "F"
    return _to_tuple(g)


def _shotgun_gone():
    g = _blank()
    _set(
        g,
        [
            (5, 12, "R"), (12, 13, "R"), (8, 16, "R"), (4, 19, "R"),
            (13, 10, "R"), (7, 21, "R"), (12, 8, "R"), (6, 10, "R"),
            (10, 18, "W"), (6, 24, "W"), (11, 22, "W"), (3, 14, "W"),
            (9, 25, "K"), (14, 20, "K"),
            (15, 24, "M"), (16, 25, "M"), (17, 26, "M"),
        ],
    )
    return _to_tuple(g)


# Доп. символы: B - бутылка, V - пар, F/O - вспышка выстрела, M - сталь дробовика/лезвие

# --- АФК: под (Aegis Boost / XROS стиль) ---
# Мундштук у губ, бак с окном жидкости, корпус в ладони. LED горит на затяжке.
_POD_CELLS = [
    (8, 9, "M"), (9, 9, "M"), (10, 9, "M"),             # мундштук у губ
    (11, 9, "M"), (13, 9, "M"), (14, 9, "M"),           # изгиб мундштука (щель 12 = рот P)
    (15, 10, "M"), (16, 10, "M"),                        # соединение с баком
    (15, 11, "M"), (16, 11, "W"), (17, 11, "K"),        # окно бака: воздух над жидкостью
    (15, 12, "M"), (16, 12, "U"), (17, 12, "M"),        # окно бака: жидкость (уровень)
    (15, 13, "M"), (16, 13, "U"), (17, 13, "M"),
    (15, 14, "K"), (16, 14, "K"), (17, 14, "K"),        # стык бака и корпуса
    (15, 15, "M"), (16, 15, "M"), (17, 15, "M"),        # корпус в ладони (GKG рука)
    (15, 16, "M"), (16, 16, "M"), (17, 16, "M"),
    (15, 17, "K"), (16, 17, "K"), (17, 17, "K"),        # днище с USB-C
]


def _pod_base():
    return _set(_clone(SPRITE_IDLE), _POD_CELLS)


