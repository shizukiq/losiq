CHAT_REPLY_RULES = (
    ("hello", re.compile(r"(?:^|[^а-яёa-z0-9_])(?:привет\w*|здравствуй\w*|здаров\w*|хай|ку|салют|хеллоу|hello|hi|hey)(?:$|[^а-яёa-z0-9_])"), CHAT_HELLO),
    ("howru", re.compile(r"\b(?:как\s+дела|как\s+ты|как\s+жизнь|как\s+сам|ч[её]\s+как|что\s+нового|в\s+порядке)\b"), CHAT_HOWRU),
    ("doing", re.compile(r"\b(?:ч[её]\s+делаешь|что\s+делаешь|чем\s+занят\w*|чем\s+занимаешься)\b"), CHAT_DOING),
    ("who", re.compile(r"\b(?:кто\s+ты|ты\s+кто|что\s+ты\s+такое|как\s+тебя\s+зовут)\b"), CHAT_WHO),
    ("love", re.compile(r"❤|♥|💕|💖|😘|😍|🥰|\b(?:люблю|скуча\w*|мил\w*|хорош\w*|обнима\w*|love)\b"), CHAT_LOVE),
    ("sad", re.compile(r"\b(?:грустн\w*|плохо|устал\w*|одинок\w*|тяжел\w*|больн\w*|паршив\w*|тоск\w*|депресс\w*)\b"), CHAT_SAD),
    ("insult", re.compile(r"\b(?:херн\w*|бред\w*|туп\w*|дурак\w*|глуп\w*|дичь|фигн\w*|чушь|бесишь|заткнись|не\s+пиши)\b"), CHAT_INSULT),
    ("bye", re.compile(r"(?:^|[^а-яёa-z0-9_])(?:пока|до\s+встречи|спокойной\s+ночи|спать\s+пош[её]л|ухожу|бб|bye)(?:$|[^а-яёa-z0-9_])"), CHAT_BYE),
    ("thanks", re.compile(r"\b(?:спасибо|спс|благодар\w*|мерси|thanks|thx)\b"), CHAT_THANKS),
)

