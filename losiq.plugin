def _luz_flash_cells():
    """Компактная вспышка у правого виска скетча."""
    cells = []
    for y in range(4, 11):
        for x in range(8, 15):
            dx = x - 11.5
            dy = (y - 6.8) * 1.2
            d2 = dx * dx + dy * dy
            if d2 <= 7:
                if d2 < 2:
                    cells.append((x, y, "K"))
                elif (x + y) % 3 == 0:
                    cells.append((x, y, "O"))
                else:
                    cells.append((x, y, "F"))
    return cells


