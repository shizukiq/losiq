def as_java_color(color: int) -> int:
    val = int(color) & 0xFFFFFFFF
    return val - 0x100000000 if val >= 0x80000000 else val


def clamp(val, lo, hi):
    return lo if val < lo else hi if val > hi else val


def _clone(base):
    return [list(row) for row in base]


def _to_tuple(grid):
    return tuple("".join(row) for row in grid)


def _set(grid, cells):
    for x, y, ch in cells:
        if 0 <= y < len(grid) and 0 <= x < len(grid[0]):
            grid[y][x] = ch
    return grid


def _blank():
    return [["."] * GRID_W for _ in range(GRID_H)]


def _tint(base, ch_to):
    return tuple("".join((ch_to if c != "." else ".") for c in row) for row in base)


def _shotgun_flash():
    g = _clone(SPRITE_IDLE)
    for y in range(2, 12):
        for x in range(2, 16):
            g[y][x] = "."
    for y in range(2, 12):
        for x in range(3, 15):
            dx = x - 9
            dy = (y - 6.5) * 1.4
            d2 = dx * dx + dy * dy
            if d2 <= 30:
                if d2 < 4:
                    g[y][x] = "K"
                elif (x + y) % 3 == 0:
                    g[y][x] = "O"
                else:
                    g[y][x] = "F"
    return _to_tuple(g)


def _shotgun_gone():
    g = _blank()
    _set(
        g,
        [
            (5, 12, "R"), (12, 13, "R"), (8, 16, "R"), (4, 19, "R"),
            (13, 10, "R"), (7, 21, "R"), (12, 8, "R"), (6, 10, "R"),
            (10, 18, "W"), (6, 24, "W"), (11, 22, "W"), (3, 14, "W"),
            (9, 25, "K"), (14, 20, "K"),
            (15, 24, "M"), (16, 25, "M"), (17, 26, "M"),
        ],
    )
    return _to_tuple(g)


